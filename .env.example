# ── piw environment configuration ──────────────────────────────────────
#
# Copy this file to .env, fill in your keys, and piw will source it
# automatically. Variables set here are passed as -e flags to Docker.
#
#   cp .env.example .env
#   $EDITOR .env
#   piw ~/my-project
#
# NOTE: .env is gitignored. Keep your keys out of version control.
#
# ── API Keys ──────────────────────────────────────────────────────────────────
# Uncomment and set the providers you use. pi resolves $VAR references in
# models.json at runtime, so these flow through automatically.

# SILICONFLOW_API_KEY=sk-...
# FIREWORKS_API_KEY=fw_...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
# DEEPSEEK_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-...
# HUGGINGFACE_API_KEY=hf_...

# ── Paths (optional) ──────────────────────────────────────────────────────────
# These override the defaults in piw. Only set if you need custom locations.

# PI_CONFIG_DIR=.pi/agent          # pi state directory (default: .pi/agent/)
#                                  # holds sessions, settings, auth, installed pkgs
# PI_TOOLS_DIR=.pi/store           # tool store (default: .pi/store/)
#                                  # holds piw tool installs; mounted at ~/.local

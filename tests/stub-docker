#!/usr/bin/env bash
# Stub `docker` for the piw CLI tests.
#
# Records each invocation on one line and succeeds. This lets the tests drive
# the real piw and inspect the image, mounts, environment, and command it would
# have handed to Docker, without needing a Docker daemon.
#
# `docker image inspect <tag>` reports success only when <tag> is listed in
# PIW_TEST_IMAGES (space-separated). Every other invocation succeeds.
#
# The log path comes from PIW_TEST_DOCKER_LOG.

args=("$@")

{
  printf '%s' "${args[0]}"
  for arg in "${args[@]:1}"; do
    printf ' %s' "$arg"
  done
  printf '\n'
} >> "${PIW_TEST_DOCKER_LOG:?PIW_TEST_DOCKER_LOG is not set}"

if [[ "${args[0]:-}" == "image" && "${args[1]:-}" == "inspect" ]]; then
  # The image tag is the last argument in both forms:
  #   image inspect <tag>
  #   image inspect --format <fmt> <tag>
  tag="${args[-1]}"
  found="false"
  for image in ${PIW_TEST_IMAGES:-}; do
    [[ "$image" == "$tag" ]] && found="true"
  done
  [[ "$found" == "true" ]] || exit 1
  # A --format request reads the piw.plan label. PIW_TEST_LABELS holds
  # space-separated <image>=<label> pairs. An image with no pair has no label.
  if [[ " ${args[*]} " == *" --format "* ]]; then
    for pair in ${PIW_TEST_LABELS:-}; do
      if [[ "${pair%%=*}" == "$tag" ]]; then
        printf '%s\n' "${pair#*=}"
        break
      fi
    done
  fi
  exit 0
fi

# `docker run ... mise ls` prints PIW_TEST_MISE_LS, so doctor can be tested
# without a real mise.
if [[ "${args[0]:-}" == "run" && "${args[-2]:-}" == "mise" && "${args[-1]:-}" == "ls" ]]; then
  [[ -n "${PIW_TEST_MISE_LS:-}" ]] && printf '%s\n' "$PIW_TEST_MISE_LS"
fi

exit 0

# ── Secrets ───────────────────────────────────────────────────────────────────
# A stray secrets file must never be committed. The live location is
# .local/.env, covered by the .local/ rule below.
.env
api.key

# ── Runtime state ─────────────────────────────────────────────────────────────
# One ignored namespace holds all user state: agent, store, app, mise,
# layers, agents/skills, piw.conf, and env.
.local/

# ── Docker ────────────────────────────────────────────────────────────────────
**/Dockerfile.dockerignore

# ── Build inputs ───────────────────────────────────────────────────────────────
# Manual downloads used by image builds. Must stay gitignored (large) but
# docker-visible: the root .dockerignore must NOT exclude build/archives/.
build/archives/

# ── Working notes ────────────────────────────────────────────────────────────
# Handoffs live at the project root and are deleted once processed.
# The handoff skill requires this pattern to be ignored.
piw-handoff-*.md
docs/handoffs/
docs/worklog/

# ── Generated artifacts ───────────────────────────────────────────────────────
skills/catalog.md

# Python bytecode from the pre-publication test scripts.
__pycache__/
*.pyc

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~

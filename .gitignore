# ── Secrets ───────────────────────────────────────────────────────────────────
# .env is the pre-.local/ location. It stays ignored until the user moves it
# to .local/env.
.env
api.key

# ── Runtime state ─────────────────────────────────────────────────────────────
# One ignored namespace holds all user state: agent, store, app, mise,
# layers, agents/skills, piw.conf, and env.
.local/

# Pre-.local/ locations. They still hold live state from before the migration,
# so they stay ignored until the user moves them. Remove these patterns after
# the migration.
.pi/
extensions/

# ── Docker ────────────────────────────────────────────────────────────────────
**/Dockerfile.dockerignore

# ── Build inputs ───────────────────────────────────────────────────────────────
# Manual downloads used by image builds. Must stay gitignored (large) but
# docker-visible: the root .dockerignore must NOT exclude build/archives/.
build/archives/

# ── Working notes ────────────────────────────────────────────────────────────
# Handoffs live at the project root and are deleted once processed.
# The handoff skill requires this pattern to be ignored.
piw-handoff-*.md
docs/handoffs/
docs/worklog/

# ── Docker bind-mount artifacts ──────────────────────────────────────────────
# skills/variant/ is a root-owned leftover. The host user cannot remove it.
skills/variant/

# ── Generated artifacts ───────────────────────────────────────────────────────
skills/catalog.md

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~

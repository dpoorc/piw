#!/usr/bin/env bash
# piw — pi-harness: launch the pi coding agent in Docker
#
# Usage:
#   piw                         Launch (default profile, current directory)
#   piw <path>                  Launch with workspace
#   piw -r, --resume            Launch with session picker
#   piw build [profile]         Build a variant (default: core)
#   piw build --no-cache        Full rebuild (ignore Docker cache)
#   piw install-packages        Install packages from extensions.txt
#   piw update                  Pull harness updates + rebuild
#   piw doctor [profile]        Diagnose harness setup
#   piw --install [dir]         Install piw symlink into PATH
#   piw --uninstall [dir]       Remove piw symlink from PATH
#   piw --profile <name>        Launch with a specific variant
#   piw --help                  Show this help
#
# Examples:
#   piw
#   piw -r
#   piw --profile devops
#   piw ~/my-project
#   piw build
#   piw build --no-cache
#   piw build devops
#   piw install-packages
#   piw doctor
#   piw doctor devops
#   piw --install
#   piw --install ~/bin
#   piw --uninstall
#   piw update
#
# Environment:
#   API keys are sourced from .env (if present) or from the host environment.
#   See .env.example for the full list of supported variables.
#
#   PI_CONFIG_DIR   Override the pi state directory (default: .pi/agent/)
#
set -euo pipefail

# ── Constants ─────────────────────────────────────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
IMAGE_PREFIX="pi-harness"
DEFAULT_PROFILE="core"

# ── Help ──────────────────────────────────────────────────────────────────────
show_help() {
  sed -n '2,38p' "$0" | sed 's/^# //; s/^#$//; s|^#||'
  exit 0
}

# ── Utility: validate profile exists ──────────────────────────────────────────
validate_profile() {
  local profile="$1"
  local dir="$SCRIPT_DIR/variants/$profile"
  if [[ ! -d "$dir" ]]; then
    echo "ERROR: Unknown profile '$profile'." >&2
    echo "  Available:" >&2
    for d in "$SCRIPT_DIR"/variants/*/; do
      name="$(basename "$d")"
      [[ "$name" != "template" ]] && echo "    - $name"
    done >&2
    exit 1
  fi
  if [[ ! -f "$dir/Dockerfile" ]]; then
    echo "ERROR: Variant '$profile' has no Dockerfile at $dir/Dockerfile" >&2
    exit 1
  fi
}

# ── Utility: resolve pi config directory ─────────────────────────────────────
resolve_config_dir() {
  if [[ "${PI_CONFIG_DIR:-}" = /* ]]; then
    echo "$PI_CONFIG_DIR"
  else
    echo "$SCRIPT_DIR/${PI_CONFIG_DIR:-.pi/agent}"
  fi
}

# ── Utility: source .env if present ───────────────────────────────────────────
load_env() {
  local env_file="$SCRIPT_DIR/.env"
  if [[ -f "$env_file" ]]; then
    set -a
    # shellcheck source=/dev/null
    source "$env_file"
    set +a
  fi
}



# ── Utility: bootstrap pi config on the host ─────────────────────────────────
bootstrap_config() {
  local config_dir="$1"
  mkdir -p "$config_dir"

  # Seed models.json
  if [[ ! -f "$config_dir/models.json" ]] && [[ -f "$SCRIPT_DIR/models.json" ]]; then
    cp "$SCRIPT_DIR/models.json" "$config_dir/models.json"
    echo "INFO: Seeded $config_dir/models.json from harness defaults."
    echo "      Edit it there to tweak models or add providers."
  fi

  # Seed settings.json
  if [[ ! -f "$config_dir/settings.json" ]] && [[ -f "$SCRIPT_DIR/settings.json" ]]; then
    cp "$SCRIPT_DIR/settings.json" "$config_dir/settings.json"
    echo "INFO: Seeded $config_dir/settings.json from harness defaults."
  fi
}

# ── Command: launch pi in Docker ──────────────────────────────────────────────
cmd_launch() {
  local profile="$1"
  local workspace="$2"
  local resume="${3:-false}"
  local variant_dir="$SCRIPT_DIR/variants/$profile"
  local image_tag="${IMAGE_PREFIX}:${profile}"

  validate_profile "$profile"

  # Workspace must exist
  if [[ ! -d "$workspace" ]]; then
    echo "ERROR: Workspace not found: $workspace" >&2
    exit 1
  fi

  # Resolve config dir (default: .pi/agent/ inside harness)
  local config_dir
  config_dir="$(resolve_config_dir)"
  bootstrap_config "$config_dir"

  # Ensure APPEND_SYSTEM.md exists
  local append_src="$SCRIPT_DIR/skills/workflow/APPEND_SYSTEM.md"
  if [[ ! -f "$append_src" ]]; then
    echo "WARNING: $append_src not found. Creating empty placeholder."
    mkdir -p "$(dirname "$append_src")"
    touch "$append_src"
  fi

  # Build image if missing
  if ! docker image inspect "$image_tag" &>/dev/null; then
    echo "INFO: Image '$image_tag' not found. Building…"
    docker build -t "$image_tag" "$variant_dir"
  fi

  # Build Docker env-var flags from known API keys
  local -a env_flags=()
  local known_keys=(
    SILICONFLOW_API_KEY
    FIREWORKS_API_KEY
    ANTHROPIC_API_KEY
    OPENAI_API_KEY
    DEEPSEEK_API_KEY
    GEMINI_API_KEY
    OPENROUTER_API_KEY
    HUGGINGFACE_API_KEY
    GROQ_API_KEY
    MISTRAL_API_KEY
    XAI_API_KEY
    TOGETHER_API_KEY
    AZURE_OPENAI_API_KEY
  )
  for var in "${known_keys[@]}"; do
    if [[ -n "${!var:-}" ]]; then
      env_flags+=(-e "$var")
    fi
  done

  local pi_args=()
  [[ "$resume" == "true" ]] && pi_args+=(-r)
  local session_flag=""
  [[ "$resume" == "true" ]] && session_flag=" (resume mode)"

  echo "INFO: Launching pi-harness ($profile) in $workspace$session_flag"
  exec docker run --rm -it \
    --add-host host.docker.internal:host-gateway \
    --user "$(id -u):$(id -g)" \
    -e HOME=/home/pi \
    -e PI_CODING_AGENT_DIR=/home/pi/.pi/agent \
    -e npm_config_cache=/tmp/.npm-cache \
    -e npm_config_ignore_scripts=true \
    "${env_flags[@]}" \
    -v "$config_dir:/home/pi/.pi/agent:z" \
    -v "$append_src:/home/pi/.pi/agent/APPEND_SYSTEM.md:z,ro" \
    -v "$SCRIPT_DIR/skills:/home/pi/.pi/agent/skills:z" \
    -v "$SCRIPT_DIR/extensions:/home/pi/.pi/agent/extensions:z" \
    -v "$workspace:$workspace:z" \
    -w "$workspace" \
    "$image_tag" \
    pi "${pi_args[@]}"
}

# ── Command: build a variant image ────────────────────────────────────────────
cmd_build() {
  local profile="$1"
  local no_cache="$2"
  local variant_dir="$SCRIPT_DIR/variants/$profile"
  local image_tag="${IMAGE_PREFIX}:${profile}"

  validate_profile "$profile"

  local build_args=("$variant_dir")
  if [[ "$no_cache" == "true" ]]; then
    build_args=("--no-cache" "${build_args[@]}")
  fi

  echo "INFO: Building pi-harness:$profile…"
  docker build -t "$image_tag" "${build_args[@]}"
  echo "INFO: Build complete: $image_tag"
}

# ── Command: install packages from extensions.txt ────────────────────────────
cmd_install_packages() {
  local profile="$1"
  local packages_file="$SCRIPT_DIR/extensions.txt"
  local config_dir
  config_dir="$(resolve_config_dir)"

  if [[ ! -f "$packages_file" ]]; then
    echo "INFO: No extensions.txt found. Nothing to install."
    return
  fi

  # Ensure image exists
  local image_tag="${IMAGE_PREFIX}:${profile}"
  if ! docker image inspect "$image_tag" &>/dev/null; then
    echo "INFO: Image '$image_tag' not found. Building…"
    docker build -t "$image_tag" "$SCRIPT_DIR/variants/$profile"
  fi

  # Read packages, skip blank lines and comments
  local packages=()
  while IFS= read -r line; do
    line="${line/#"${line%%[![:space:]]*}"/}"   # trim leading whitespace
    line="${line/%"${line##*[![:space:]]}"/}"   # trim trailing whitespace
    [[ -z "$line" ]] && continue
    [[ "$line" == \#* ]] && continue
    packages+=("$line")
  done < "$packages_file"

  if [[ ${#packages[@]} -eq 0 ]]; then
    echo "INFO: No packages listed in extensions.txt."
    return
  fi

  local settings_file="$config_dir/settings.json"
  local exit_code=0

  echo "Installing packages for pi-harness:$profile…"
  for pkg in "${packages[@]}"; do
    # Skip if already installed (mentioned in settings.json)
    if [[ -f "$settings_file" ]] && grep -qF "$pkg" "$settings_file" 2>/dev/null; then
      echo "  ✓ $pkg (already installed)"
      continue
    fi

    printf "  Installing %s… " "$pkg"
    if docker run --rm \
      -v "$config_dir:/home/pi/.pi/agent:z" \
      -e npm_config_cache=/tmp/.npm-cache \
      -e npm_config_ignore_scripts=true \
      "$image_tag" \
      pi install "$pkg" &>/dev/null; then
      echo "done"
    else
      echo "failed" >&2
      exit_code=1
    fi
  done

  if [[ "$exit_code" -ne 0 ]]; then
    echo "WARNING: One or more packages failed to install." >&2
  fi
}

# ── Command: install piw symlink into PATH ────────────────────────────────────
cmd_install() {
  local target_dir="${1:-$HOME/.local/bin}"
  local link_path="$target_dir/piw"
  local piw_path="$SCRIPT_DIR/piw"

  mkdir -p "$target_dir"

  if [[ -L "$link_path" ]]; then
    local current
    current="$(readlink "$link_path")"
    if [[ "$current" == "$piw_path" ]]; then
      echo "✓ piw already installed at $link_path"
    else
      ln -sf "$piw_path" "$link_path"
      echo "✓ Updated symlink: $link_path → $piw_path (was → $current)"
    fi
  elif [[ -f "$link_path" ]]; then
    echo "ERROR: $link_path exists and is not a symlink. Remove it first." >&2
    exit 1
  else
    ln -s "$piw_path" "$link_path"
    echo "✓ Installed: $link_path → $piw_path"
  fi

  # Seed configs (same as launch does)
  local config_dir
  config_dir="$(resolve_config_dir)"
  bootstrap_config "$config_dir"

  if [[ ":$PATH:" != *":$target_dir:"* ]]; then
    echo ""
    echo "NOTE: $target_dir is not on your PATH. Add this to ~/.bashrc / ~/.zshrc:"
    echo "  export PATH=\"\$PATH:$target_dir\""
  fi

  echo ""
  echo "✓ pi-harness installed. Run 'piw' to launch."
}

# ── Command: remove piw symlink from PATH ────────────────────────────────────
cmd_uninstall() {
  local target_dir="${1:-$HOME/.local/bin}"
  local link_path="$target_dir/piw"
  local piw_path="$SCRIPT_DIR/piw"

  if [[ ! -L "$link_path" ]] && [[ ! -e "$link_path" ]]; then
    echo "✓ piw not found at $link_path (nothing to remove)"
    return
  fi

  if [[ -L "$link_path" ]]; then
    local current
    current="$(readlink "$link_path")"
    if [[ "$current" != "$piw_path" ]]; then
      echo "ERROR: $link_path points to $current, not $piw_path. Not removing." >&2
      exit 1
    fi
    rm "$link_path"
    echo "✓ Removed symlink: $link_path"
  else
    echo "ERROR: $link_path is a regular file. Remove manually." >&2
    exit 1
  fi

  local config_dir
  config_dir="$(resolve_config_dir)"
  if [[ -d "$config_dir" ]]; then
    echo ""
    echo "NOTE: Config directory still exists at $config_dir"
    echo "  Remove with: rm -rf $config_dir"
  fi
}

# ── Command: diagnose harness setup ──────────────────────────────────────────
cmd_doctor() {
  local profile="${1:-$DEFAULT_PROFILE}"
  local errors=0

  echo "pi-harness doctor — diagnosing \"$profile\" profile"
  echo ""

  # ── Docker ──
  echo "── Docker ──"
  if command -v docker &>/dev/null; then
    echo "  ✓ docker found at $(command -v docker)"
    if docker info &>/dev/null 2>&1; then
      echo "  ✓ Docker daemon is running"
    else
      echo "  ✗ Docker daemon is not running (or permission denied)"
      errors+=1
    fi
  else
    echo "  ✗ docker not found on PATH"
    errors+=1
  fi

  # ── Variant ──
  echo "── Variant ($profile) ──"
  local variant_dir="$SCRIPT_DIR/variants/$profile"
  if [[ -d "$variant_dir" ]]; then
    echo "  ✓ Variant directory: $variant_dir"
    if [[ -f "$variant_dir/Dockerfile" ]]; then
      echo "  ✓ Dockerfile exists"
    else
      echo "  ✗ No Dockerfile in $variant_dir"
      errors+=1
    fi
  else
    echo "  ✗ Variant directory not found: $variant_dir"
    errors+=1
  fi

  # ── Docker image ──
  local image_tag="${IMAGE_PREFIX}:${profile}"
  if docker image inspect "$image_tag" &>/dev/null 2>&1; then
    echo "  ✓ Docker image built: $image_tag"
  else
    echo "  ⚠ Docker image not yet built (auto-built on first launch)"
  fi

  # ── Environment ──
  echo "── Environment ──"
  if [[ -f "$SCRIPT_DIR/.env" ]]; then
    echo "  ✓ .env file exists"
    if grep -qP '^[A-Z_]+=\s*$' "$SCRIPT_DIR/.env" 2>/dev/null; then
      echo "  ⚠ Some variables in .env are empty (placeholders?)"
    fi
  else
    echo "  ⚠ .env not found (copy .env.example to .env)"
  fi

  local found_keys=0
  for var in ANTHROPIC_API_KEY OPENAI_API_KEY GEMINI_API_KEY FIREWORKS_API_KEY; do
    if [[ -n "${!var:-}" ]]; then
      echo "  ✓ $var is set"
      found_keys+=1
    fi
  done
  if [[ $found_keys -eq 0 ]]; then
    echo "  ⚠ No API keys found (set at least one in .env or export it)"
  fi

  # ── Config directory ──
  echo "── Config ──"
  local config_dir
  config_dir="$(resolve_config_dir)"
  if [[ -d "$config_dir" ]]; then
    echo "  ✓ Config directory: $config_dir"
    [[ -f "$config_dir/settings.json" ]] && echo "  ✓ settings.json" || echo "  ⚠ No settings.json (seeded on first launch)"
    [[ -f "$config_dir/models.json" ]] && echo "  ✓ models.json" || echo "  ⚠ No models.json (seeded on first launch)"
  else
    echo "  ⚠ Config directory not found (created on first launch)"
  fi

  # ── Skills & Extensions ──
  echo "── Skills & Extensions ──"
  if [[ -d "$SCRIPT_DIR/skills/workflow" ]]; then
    echo "  ✓ Workflow skill: skills/workflow"
    [[ -f "$SCRIPT_DIR/skills/workflow/SKILL.md" ]] && echo "  ✓   SKILL.md" || echo "  ⚠   Missing SKILL.md"
    [[ -f "$SCRIPT_DIR/skills/workflow/APPEND_SYSTEM.md" ]] && echo "  ✓   APPEND_SYSTEM.md" || echo "  ⚠   Missing APPEND_SYSTEM.md"
  else
    echo "  ⚠ Workflow skill directory not found: skills/workflow"
  fi
  [[ -d "$SCRIPT_DIR/skills/ready" ]] && echo "  ✓ skills/ready directory" || echo "  ⚠ skills/ready not found (optional)"
  [[ -d "$SCRIPT_DIR/extensions" ]] && echo "  ✓ Extensions directory" || echo "  ⚠ Extensions directory not found"

  # ── Packages ──
  echo "── Packages ──"
  if [[ -f "$SCRIPT_DIR/extensions.txt" ]]; then
    echo "  ✓ extensions.txt found"
    if [[ -f "$config_dir/settings.json" ]]; then
      local total=0 installed=0
      while IFS= read -r line; do
        line="${line/#"${line%%[![:space:]]*}"/}"
        line="${line/%"${line##*[![:space:]]}"/}"
        [[ -z "$line" ]] && continue
        [[ "$line" == \#* ]] && continue
        total+=1
        if grep -qF "$line" "$config_dir/settings.json" 2>/dev/null; then
          installed+=1
        fi
      done < "$SCRIPT_DIR/extensions.txt"
      echo "  Packages: $installed/$total installed"
      if [[ $installed -lt $total ]]; then
        echo "  ⚠ Run 'piw install-packages' to install missing packages"
      fi
    else
      echo "  ⚠ Cannot check package status (settings.json not seeded yet)"
    fi
  else
    echo "  ⚠ No extensions.txt found"
  fi

  # ── rtk ──
  echo "── rtk ──"
  local image_tag="${IMAGE_PREFIX}:${profile}"
  if docker image inspect "$image_tag" &>/dev/null 2>&1; then
    if rtk_version=$(docker run --rm "$image_tag" rtk --version 2>/dev/null); then
      echo "  ✓ $rtk_version"
    else
      echo "  ⚠ rtk binary not found (rebuild image with 'piw build $profile')"
    fi
  else
    echo "  ⚠ Cannot check rtk (image not built yet)"
  fi

  # ── Repository ──
  echo "── Repository ──"
  if git -C "$SCRIPT_DIR" rev-parse --git-dir &>/dev/null 2>&1; then
    echo "  ✓ Git repository"
    if [[ -z "$(git -C "$SCRIPT_DIR" status --porcelain 2>/dev/null)" ]]; then
      echo "  ✓ Working tree clean"
    else
      echo "  ⚠ Uncommitted changes"
    fi
  else
    echo "  ⚠ Not a git repository"
  fi

  # ── Summary ──
  echo ""
  if [[ $errors -eq 0 ]]; then
    echo "✓ All checks passed. Run 'piw' to launch."
  else
    echo "✗ $errors issue(s) found. Review the items above."
    return 1
  fi
}

# ── Command: update harness and rebuild ───────────────────────────────────────
cmd_update() {
  local profile="${1:-$DEFAULT_PROFILE}"
  local no_cache="${2:-false}"
  local do_all="${3:-false}"

  # Pull harness updates
  if git -C "$SCRIPT_DIR" remote -v &>/dev/null; then
    echo "INFO: Pulling harness updates from git…"
    if ! git -C "$SCRIPT_DIR" pull --rebase 2>&1; then
      echo "ERROR: Git pull failed. Resolve conflicts and try again." >&2
      return 1
    fi
  else
    echo "INFO: No git remote configured. Skipping pull."
  fi

  if [[ "$do_all" == "true" ]]; then
    for variant_dir in "$SCRIPT_DIR"/variants/*/; do
      local p
      p="$(basename "$variant_dir")"
      [[ "$p" == "template" ]] && continue
      echo "--- $p ---"
      cmd_build "$p" "$no_cache"
      cmd_install_packages "$p"
    done
  else
    cmd_build "$profile" "$no_cache"
    cmd_install_packages "$profile"
  fi

  echo ""
  echo "✓ Update complete. Run 'piw' to launch."
}

# ── Main ──────────────────────────────────────────────────────────────────────
load_env

PROFILE="$DEFAULT_PROFILE"
COMMAND=""
NO_CACHE="false"
RESUME="false"
UPDATE_ALL="false"
POSITIONAL=()

while [[ $# -gt 0 ]]; do
  case "$1" in
  --profile)
    if [[ -z "${2:-}" ]]; then
      echo "ERROR: --profile requires an argument" >&2
      exit 1
    fi
    PROFILE="$2"
    shift 2
    ;;
  --no-cache)
    NO_CACHE="true"
    shift
    ;;
  -r | --resume)
    RESUME="true"
    shift
    ;;
  --all)
    UPDATE_ALL="true"
    shift
    ;;
  --install)
    COMMAND="install"
    shift
    ;;
  --uninstall)
    COMMAND="uninstall"
    shift
    ;;
  --help | -h)
    show_help
    ;;
  build | update | install-packages | install | uninstall | doctor)
    COMMAND="$1"
    shift
    ;;
  -*)
    echo "ERROR: Unknown option: $1" >&2
    echo "Usage: piw [--profile <name>] [--resume|-r] [--install|--uninstall] [--help]" >&2
    exit 1
    ;;
  *)
    POSITIONAL+=("$1")
    shift
    ;;
  esac
done

case "$COMMAND" in
build)
  cmd_build "${POSITIONAL[0]:-$PROFILE}" "$NO_CACHE"
  ;;
update)
  cmd_update "${POSITIONAL[0]:-}" "$NO_CACHE" "$UPDATE_ALL"
  ;;
install-packages)
  cmd_install_packages "${POSITIONAL[0]:-$PROFILE}"
  ;;
install)
  cmd_install "${POSITIONAL[0]:-}"
  ;;
uninstall)
  cmd_uninstall "${POSITIONAL[0]:-}"
  ;;
doctor)
  cmd_doctor "${POSITIONAL[0]:-$PROFILE}"
  ;;
*)
  cmd_launch "$PROFILE" "${POSITIONAL[0]:-$(pwd)}" "$RESUME"
  ;;
esac

#!/usr/bin/env bash
# piw — pi-harness: launch the pi coding agent in Docker
#
# Model:
#   The Docker image is tooling + isolation only. pi lives in its own
#   app mount (~/.pihub); extensions live in the config mount (.pi/agent/).
#   Both update without image rebuilds. `piw update` is the one command
#   that brings everything (repo, images, pi, extensions) current.
#
# Usage:
#   piw                         Launch (default profile, current directory)
#   piw <path>                  Launch with workspace
#   piw -r, --resume            Launch with session picker
#   piw build [profile]         Build tooling image + provision mount (default: core)
#   piw build --all             Build all variants + provision mount
#   piw build --no-cache        Full rebuild (ignore Docker cache)
#   piw build --offline         Build from build/archives only, no downloads
#   piw update                  Pull + rebuild + upgrade pi + sync extensions
#   piw update --all            Update all variants
#   piw update --build-only     Pull + rebuild (skip pi/extensions)
#   piw update --install-only   Pull + sync pi/extensions (skip build)
#   piw update --force          Reinstall all extensions
#   piw update --dry-run        Show what would change (no executions)
#   piw doctor [profile]        Diagnose harness setup
#   piw generate-catalog        Regenerate skills catalog from SKILL.md files
#   piw tool install <spec>...   Install tools into the shared store
#   piw tool list               List tools in the shared store
#   piw tool remove <spec>...   Remove tools from the shared store
#   piw --install [dir]         Install piw symlink into PATH
#   piw --uninstall [dir]       Remove piw symlink from PATH
#   piw --profile <name>        Launch with a specific variant
#   piw --mode <name>           Launch with a permission mode (default: permissive)
#                              Available: permissive, restricted, readonly
#   piw --help                  Show this help
#
# Environment:
#   API keys are sourced from .env (if present) or from the host environment.
#   See .env.example for the full list of supported variables.
#
#   PI_CONFIG_DIR   Override the pi state directory (default: .pi/agent/)
#   PI_PI_DIR       Override the pi app directory (default: .pi/app)
#   PI_TOOLS_DIR    Override the tool store directory (default: .pi/tools)
#   PIW_MODE        Permission mode (permissive, restricted, readonly)
#   PIW_DEFAULT_PROFILE  Default variant profile (overrides "core")
#
set -euo pipefail

# ── Constants ─────────────────────────────────────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
IMAGE_PREFIX="pi-harness"

# ── Help ──────────────────────────────────────────────────────────────────────
show_help() {
  # Print the header comment block dynamically (lines from after the
  # shebang up to the first non-comment line), so the help text can
  # grow without renumbering a hardcoded range.
  awk '
    NR == 1 { next }
    /^#/ {
      line = $0
      sub(/^# ?/, "", line)
      print line
      next
    }
    { exit }
  ' "$0"
  exit 0
}

# ── Utility: validate profile exists ──────────────────────────────────────────
validate_profile() {
  local profile="$1"
  local dir="$SCRIPT_DIR/variants/$profile"
  if [[ ! -d "$dir" ]]; then
    echo "ERROR: Unknown profile '$profile'." >&2
    echo "  Available:" >&2
    for d in "$SCRIPT_DIR"/variants/*/; do
      name="$(basename "$d")"
      [[ "$name" != "template" ]] && echo "    - $name"
    done >&2
    exit 1
  fi
  if [[ ! -f "$dir/Dockerfile" ]]; then
    echo "ERROR: Variant '$profile' has no Dockerfile at $dir/Dockerfile" >&2
    exit 1
  fi
}

# ── Utility: validate mode exists ────────────────────────────────────────────
validate_mode() {
  local mode="$1"
  if [[ "$mode" == "permissive" ]]; then
    return 0
  fi
  local seed_config="$SCRIPT_DIR/config-seeds/permissions/config.$mode.json"
  local live_config="$SCRIPT_DIR/extensions/pi-permission-system/config.$mode.json"
  if [[ ! -f "$seed_config" && ! -f "$live_config" ]]; then
    echo "ERROR: Unknown mode '$mode'." >&2
    echo "  Available modes:" >&2
    local f name
    local -a modes=()
    for f in "$SCRIPT_DIR"/config-seeds/permissions/config.*.json \
             "$SCRIPT_DIR"/extensions/pi-permission-system/config.*.json; do
      [[ -f "$f" ]] || continue
      name="$(basename "$f" .json)"
      name="${name#config.}"
      [[ " ${modes[*]} " == *" $name "* ]] && continue
      modes+=("$name")
    done
    for name in "${modes[@]}"; do
      echo "    - $name" >&2
    done
    exit 1
  fi
}

# ── Utility: resolve mode config path (empty for permissive) ─────────────────
resolve_mode_config() {
  local mode="$1"
  if [[ "$mode" == "permissive" ]]; then
    echo ""
    return
  fi
  echo "$SCRIPT_DIR/extensions/pi-permission-system/config.$mode.json"
}

# ── Utility: resolve pi config directory ─────────────────────────────────────
resolve_config_dir() {
  if [[ "${PI_CONFIG_DIR:-}" = /* ]]; then
    echo "$PI_CONFIG_DIR"
  else
    echo "$SCRIPT_DIR/${PI_CONFIG_DIR:-.pi/agent}"
  fi
}

# ── Utility: source .env if present ───────────────────────────────────────────
load_env() {
  local env_file="$SCRIPT_DIR/.env"
  if [[ -f "$env_file" ]]; then
    set -a
    # shellcheck source=/dev/null
    source "$env_file"
    set +a
  fi
}

# ── Utility: bootstrap pi config on the host ─────────────────────────────────
bootstrap_config() {
  local config_dir="$1"
  mkdir -p "$config_dir"

  # Seed models.json
  if [[ ! -f "$config_dir/models.json" ]] && [[ -f "$SCRIPT_DIR/config-seeds/models.json" ]]; then
    cp "$SCRIPT_DIR/config-seeds/models.json" "$config_dir/models.json"
    echo "INFO: Seeded $config_dir/models.json from harness defaults."
    echo "      Edit it there to tweak models or add providers."
  fi

  # Seed settings.json
  if [[ ! -f "$config_dir/settings.json" ]] && [[ -f "$SCRIPT_DIR/config-seeds/settings.json" ]]; then
    cp "$SCRIPT_DIR/config-seeds/settings.json" "$config_dir/settings.json"
    echo "INFO: Seeded $config_dir/settings.json from harness defaults."
  fi
}

# ── Utility: seed permission configs into the live extension directory ───────
# The live extensions/ directory is gitignored user state. Shipped policies
# live in config-seeds/permissions/ and are copied in only when absent.
bootstrap_permissions() {
  local seed_dir="$SCRIPT_DIR/config-seeds/permissions"
  local live_dir="$SCRIPT_DIR/extensions/pi-permission-system"

  mkdir -p "$live_dir"

  [[ -d "$seed_dir" ]] || return 0

  local seed name seeded="false"
  for seed in "$seed_dir"/config*.json; do
    [[ -f "$seed" ]] || continue
    name="$(basename "$seed")"
    if [[ ! -f "$live_dir/$name" ]]; then
      cp "$seed" "$live_dir/$name"
      seeded="true"
    fi
  done
  if [[ "$seeded" == "true" ]]; then
    echo "INFO: Seeded permission configs into $live_dir"
  fi
}

# ── Utility: list non-template variant names ─────────────────────────────────
variant_names() {
  for dir in "$SCRIPT_DIR"/variants/*/; do
    local name
    name="$(basename "$dir")"
    [[ "$name" != "template" ]] && echo "$name"
  done
}

# ── Utility: archives required by a profile ─────────────────────────────────
_profile_archives() {
  case "$1" in
  devops)
    echo "yq_linux_amd64.tar.gz"
    ;;
  workstation)
    cat <<'EOF'
go1.27.1.linux-amd64.tar.gz
rust-1.98.1-x86_64-unknown-linux-gnu.tar.xz
rust-1.98.1-x86_64-unknown-linux-musl.tar.xz
rizin-v0.9.1-static-x86_64.tar.xz
ffmpeg-n9.0-latest-linux64-gpl-9.0.tar.xz
yq_linux_amd64.tar.gz
yadm-3.5.0
tofu_1.12.6_linux_amd64.tar.gz
packer_1.16.0_linux_amd64.zip
hadolint-linux-x86_64
tflint_linux_amd64.zip
uv-x86_64-unknown-linux-gnu.tar.gz
EOF
    ;;
  esac
}

# ── Utility: per-archive download URL (mirrors build/README.md) ─────────────
_archive_url() {
  case "$1" in
  go1.27.1.linux-amd64.tar.gz) echo "https://go.dev/dl/$1" ;;
  rust-1.98.1-x86_64-unknown-linux-gnu.tar.xz | rust-1.98.1-x86_64-unknown-linux-musl.tar.xz) echo "https://static.rust-lang.org/dist/$1" ;;
  rizin-v0.9.1-static-x86_64.tar.xz) echo "https://github.com/rizinorg/rizin/releases/download/v0.9.1/$1" ;;
  ffmpeg-n9.0-latest-linux64-gpl-9.0.tar.xz) echo "https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/$1" ;;
  yq_linux_amd64.tar.gz) echo "https://github.com/mikefarah/yq/releases/latest/download/$1" ;;
  yadm-3.5.0) echo "https://raw.githubusercontent.com/TheLocehiliosan/yadm/3.5.0/yadm" ;;
  tofu_1.12.6_linux_amd64.tar.gz) echo "https://github.com/opentofu/opentofu/releases/download/v1.12.6/$1" ;;
  packer_1.16.0_linux_amd64.zip) echo "https://releases.hashicorp.com/packer/1.16.0/$1" ;;
  hadolint-linux-x86_64) echo "https://github.com/hadolint/hadolint/releases/latest/download/hadolint-Linux-x86_64" ;;
  tflint_linux_amd64.zip) echo "https://github.com/terraform-linters/tflint/releases/latest/download/$1" ;;
  uv-x86_64-unknown-linux-gnu.tar.gz) echo "https://github.com/astral-sh/uv/releases/download/0.12.13/$1" ;;
  esac
}

# ── Utility: ensure required archives exist before an image build ───────────
ensure_archives() {
  local profile="$1"
  local offline="${2:-false}"
  local archive_dir="$SCRIPT_DIR/build/archives"

  # Archives are published for amd64; refuse to build elsewhere rather than
  # ship a silent runtime breakage (image says amd64, binaries are not).
  # See build/README.md for the manual aarch64 archive swap.
  if [[ "$(uname -m)" != "x86_64" ]]; then
    echo "ERROR: build/archives are amd64-only; this host is $(uname -m)." >&2
    echo "  See build/README.md for how to swap in aarch64 archives manually." >&2
    exit 1
  fi
  local -a missing=()
  local file

  mkdir -p "$archive_dir"
  for file in $(_profile_archives "$profile"); do
    [[ -f "$archive_dir/$file" ]] || missing+=("$file")
  done

  if [[ ${#missing[@]} -eq 0 ]]; then
    return 0
  fi

  echo "WARNING: Missing archives for profile '$profile':" >&2
  if [[ "$offline" == "true" ]]; then
    for file in "${missing[@]}"; do
      echo "  - $file" >&2
    done
    echo "Fetch them manually. Source URLs are in build/README.md." >&2
    exit 1
  fi

  for file in "${missing[@]}"; do
    local url
    url="$(_archive_url "$file")"
    echo "  Downloading $file…" >&2
    if ! curl -fsSL --create-dirs -o "$archive_dir/$file" "$url"; then
      echo "ERROR: Could not download $file from $url" >&2
      echo "  Fetch it manually and place it in $archive_dir." >&2
      exit 1
    fi
  done
}

# ── Utility: ensure Docker image exists for a profile ────────────────────────
ensure_image() {
  local profile="$1"
  local dry_run="${2:-false}"
  local image_tag="${IMAGE_PREFIX}:${profile}"
  if ! docker image inspect "$image_tag" &>/dev/null; then
    if [[ "$dry_run" == "true" ]]; then
      echo "INFO: (dry-run) Image '$image_tag' is missing — would build."
      return 0
    fi
    echo "INFO: Image '$image_tag' not found. Building…"
    ensure_archives "$profile"
    docker build -f "$SCRIPT_DIR/variants/$profile/Dockerfile" -t "$image_tag" "$SCRIPT_DIR"
  fi
}

# ── Utility: pi app dir (host side) ─────────────────────────────────────────
PI_MOUNT_PREFIX="/opt/pi"
PI_NPM_PKG="@earendil-works/pi-coding-agent"

resolve_pi_host_dir() {
  # Mirror resolve_config_dir: an absolute PI_PI_DIR wins; otherwise the
  # harness owns everything under its own .pi/ (state: .pi/agent, app: .pi/app).
  if [[ "${PI_PI_DIR:-}" = /* ]]; then
    echo "$PI_PI_DIR"
  else
    echo "$SCRIPT_DIR/${PI_PI_DIR:-.pi/app}"
  fi
}

# ── Utility: resolve the shared tool store directory ─────────────────────────
resolve_tools_dir() {
  # Mirror the other resolvers: an absolute PI_TOOLS_DIR wins; otherwise the
  # harness owns the store under its own .pi/.
  if [[ "${PI_TOOLS_DIR:-}" = /* ]]; then
    echo "$PI_TOOLS_DIR"
  else
    echo "$SCRIPT_DIR/${PI_TOOLS_DIR:-.pi/tools}"
  fi
}

# ── Utility: create the tool store before Docker can create it as root ───────
# A missing bind-mount source is created by Docker as root:root, and the host
# user cannot then write it. Create it here, as the user.
ensure_tools_dir() {
  mkdir -p "$(resolve_tools_dir)/bin"
}

# ── Utility: run a command inside the harness image ──────────────────────────
# The image is the stable environment. Tool actions run here, never through a
# host package manager. Leading -v/-e pairs are passed through as extra
# mounts and env vars.
_in_container() {
  local profile="$1"
  shift
  local -a extra=()
  while [[ "${1:-}" == "-v" || "${1:-}" == "-e" ]]; do
    extra+=("$1" "${2:?missing value for $1}")
    shift 2
  done

  ensure_tools_dir
  docker run --rm \
    --user "$(id -u):$(id -g)" \
    -e HOME=/home/pi \
    -e PI_CODING_AGENT_DIR=/home/pi/.pi/agent \
    -e npm_config_cache=/tmp/.npm-cache \
    -e npm_config_ignore_scripts=true \
    -v "$(resolve_config_dir):/home/pi/.pi/agent:z" \
    -v "$(resolve_tools_dir):/home/pi/.local:z" \
    "${extra[@]}" \
    "${IMAGE_PREFIX}:${profile}" \
    "$@"
}

# ── Utility: installed pi version (host-side read from the app dir) ─────────
_pi_installed_version() {
  local pi_host="$1"
  local pkg_json="$pi_host/node_modules/@earendil-works/pi-coding-agent/package.json"
  if [[ ! -f "$pkg_json" ]]; then
    echo ""
    return
  fi
  sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$pkg_json" | head -1
}

# ── Utility: latest version from npm (host npm, else container npm) ──────────
_npm_latest_version() {
  local spec="$1"
  if command -v npm &>/dev/null 2>&1; then
    npm view "$spec" version 2>/dev/null | tail -1 || true
  else
    docker run --rm \
      --user "$(id -u):$(id -g)" \
      -e HOME=/home/pi \
      -e npm_config_cache=/tmp/.npm-cache \
      "${IMAGE_PREFIX}:core" \
      npm view "$spec" version 2>/dev/null | tail -1 || true
  fi
}

# ── Utility: ensure pi is present in the config mount ────────────────────────
# mode: require  — install if missing; never check the registry
#       upgrade  — bring to latest when npm is reachable, keep otherwise
ensure_pi() {
  local profile="$1"
  local mode="${2:-require}"
  local dry_run="${3:-false}"
  local config_dir
  config_dir="$(resolve_config_dir)"
  local image_tag="${IMAGE_PREFIX}:${profile}"
  local installed latest pi_host

  ensure_image "$profile" "$dry_run"

  pi_host="$(resolve_pi_host_dir)"
  mkdir -p "$pi_host"

  installed="$(_pi_installed_version "$pi_host")"

  # require mode stays offline: pi exists, so there is nothing to do. pi
  # reports its own updates.
  if [[ "$mode" == "require" && -n "$installed" ]]; then
    echo "INFO: pi $installed present."
    return 0
  fi

  # The install path and upgrade mode need the published version.
  latest="$(_npm_latest_version "$PI_NPM_PKG")"

  if [[ -n "$installed" && -z "$latest" ]]; then
    echo "INFO: pi $installed present (offline — cannot check npm)."
    return 0
  fi
  if [[ "$mode" == "upgrade" && -n "$installed" && "$installed" == "$latest" ]]; then
    echo "INFO: pi $installed is current."
    return 0
  fi
  if [[ -z "$installed" && -z "$latest" ]]; then
    echo "ERROR: pi is not installed and npm is unreachable (offline?)." >&2
    echo "  Run 'piw update' with network access to install pi." >&2
    exit 1
  fi

  if [[ "$dry_run" == "true" ]]; then
    echo "(dry-run) Would install pi ${latest:-latest} (was: ${installed:-none})."
    return 0
  fi

  echo "INFO: Installing pi ${latest:-latest} (was: ${installed:-none}) into app mount…"
  if ! docker run --rm \
    --user "$(id -u):$(id -g)" \
    -e HOME=/home/pi \
    -e PI_CODING_AGENT_DIR=/home/pi/.pi/agent \
    -e npm_config_cache=/tmp/.npm-cache \
    -e npm_config_ignore_scripts=true \
    -v "$config_dir:/home/pi/.pi/agent:z" \
    -v "$pi_host:/opt/pi:z" \
    "$image_tag" \
    sh -c "rm -rf '$PI_MOUNT_PREFIX'/node_modules && npm install --prefix '$PI_MOUNT_PREFIX' '$PI_NPM_PKG@${latest:-latest}'"; then
    echo "ERROR: npm install of pi failed (see output above)." >&2
    exit 1
  fi

  # Verify the installed CLI actually runs from the mount
  if ! docker run --rm \
    --user "$(id -u):$(id -g)" \
    -e HOME=/home/pi \
    -v "$pi_host:/opt/pi:z" \
    "$image_tag" \
    /opt/pi/node_modules/.bin/pi --version; then
    echo "ERROR: installed pi does not run from /opt/pi (broken mount or install)." >&2
    exit 1
  fi
}

# ── Utility: mount directory for an extension source ─────────────────────────
#   npm:<name>        → $config_dir/npm/node_modules/<name>
#   git:<host>/<path> → $config_dir/git/<host>/<path> (@tag suffix stripped)
_pkg_mount_dir() {
  local config_dir="$1"
  local pkg="$2"
  case "$pkg" in
  npm:*) echo "$config_dir/npm/node_modules/${pkg#npm:}" ;;
  git:*)
    local path="${pkg#git:}"
    path="${path#https://}"
    path="${path#git@}"
    path="${path%%@*}"
    path="${path//:/}"
    echo "$config_dir/git/$path"
    ;;
  *) echo "" ;;
  esac
}

# ── Utility: installed extension version (host-side read; git: → "") ────────
_pkg_installed_version() {
  local dir="$1"
  local pkg_json="$dir/package.json"
  if [[ ! -f "$pkg_json" ]]; then
    echo ""
    return
  fi
  sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$pkg_json" | head -1
}

# ── Utility: install one extension via pi install (throwaway container) ──────
_pi_install_one() {
  local image_tag="$1"
  local config_dir="$2"
  local pkg="$3"
  local pi_host
  pi_host="$(resolve_pi_host_dir)"

  # Deterministic preflight: the mounted CLI must exist before we spawn a
  # container that would otherwise fail with an opaque exec error.
  if [[ ! -x "$pi_host/node_modules/.bin/pi" ]]; then
    echo "ERROR: pi is not installed in the app mount ($pi_host)." >&2
    echo "  Run 'piw update' or 'piw build' first (ensure_pi installs it)." >&2
    return 1
  fi

  # Invoke via absolute path — never depends on PATH resolution inside the
  # container (the /opt/pi node_modules/.bin entry would be found only
  # when the mount is populated, which the preflight just guaranteed).
  docker run --rm \
    --user "$(id -u):$(id -g)" \
    -e HOME=/home/pi \
    -e PI_CODING_AGENT_DIR=/home/pi/.pi/agent \
    -v "$config_dir:/home/pi/.pi/agent:z" \
    -v "$pi_host:/opt/pi:z" \
    -e npm_config_cache=/tmp/.npm-cache \
    -e npm_config_ignore_scripts=true \
    "$image_tag" \
    /opt/pi/node_modules/.bin/pi install "$pkg"
}

# ── Utility: sync extensions from extensions.txt into the config mount ──────
# force=false — install missing, upgrade outdated npm extensions
# force=true  — reinstall every listed extension
sync_extensions_for() {
  local profile="$1"
  local force="${2:-false}"
  local dry_run="${3:-false}"
  local packages_file="$SCRIPT_DIR/config-seeds/extensions.txt"
  local config_dir
  config_dir="$(resolve_config_dir)"

  if [[ ! -f "$packages_file" ]]; then
    echo "INFO: No extensions.txt found. Nothing to sync."
    return
  fi

  # Read extensions, skip blank lines and comments
  local -a packages=()
  while IFS= read -r line; do
    line="${line/#"${line%%[![:space:]]*}"/}"
    line="${line/%"${line##*[![:space:]]}"/}"
    [[ -z "$line" ]] && continue
    [[ "$line" == \#* ]] && continue
    packages+=("$line")
  done <"$packages_file"

  if [[ ${#packages[@]} -eq 0 ]]; then
    echo "INFO: No extensions listed in extensions.txt."
    return
  fi

  ensure_image "$profile" "$dry_run"
  ensure_pi "$profile" require "$dry_run"

  local image_tag="${IMAGE_PREFIX}:${profile}"
  local exit_code=0 installed=0 upgraded=0 skipped=0 failed=0

  echo "Syncing extensions for pi-harness:$profile…"

  for pkg in "${packages[@]}"; do
    local dir ver latest verb
    dir="$(_pkg_mount_dir "$config_dir" "$pkg")"

    if [[ "$force" == "true" ]]; then
      verb="reinstall"
    elif [[ "$pkg" == npm:* ]]; then
      ver="$(_pkg_installed_version "$dir")"
      latest="$(_npm_latest_version "${pkg#npm:}")"  # strip pi's npm: URI scheme
      if [[ -z "$ver" ]]; then
        verb="install"
      elif [[ -n "$latest" && "$ver" != "$latest" ]]; then
        verb="upgrade ($ver → $latest)"
      else
        verb="current ($ver)"
      fi
    elif [[ -d "$dir" ]]; then
      verb="present (git)"
    else
      verb="install"
    fi

    case "$verb" in
    current*|present*)
      echo "  ✓ $pkg ($verb)"
      ((skipped+=1))
      ;;
    install)
      if [[ "$dry_run" == "true" ]]; then
        echo "  → $pkg (would install)"
        ((installed+=1))
        continue
      fi
      printf "  Installing %s… " "$pkg"
      if _pi_install_one "$image_tag" "$config_dir" "$pkg"; then
        echo "done"
        ((installed+=1))
      else
        echo "failed" >&2
        ((failed+=1))
        exit_code=1
      fi
      ;;
    *)
      # upgrade/ reinstall buckets
      if [[ "$dry_run" == "true" ]]; then
        echo "  → $pkg ($verb — would run)"
        ((upgraded+=1))
        continue
      fi
      printf "  %s %s… " "$( [[ "$verb" == "reinstall" ]] && echo Reinstalling || echo Upgrading)" "$pkg"
      if _pi_install_one "$image_tag" "$config_dir" "$pkg"; then
        echo "done"
        ((upgraded+=1))
      else
        echo "failed" >&2
        ((failed+=1))
        exit_code=1
      fi
      ;;
    esac
  done

  echo ""
  echo "  Summary: $installed installed, $upgraded upgraded, $skipped current, $failed failed"
  if [[ "$exit_code" -ne 0 ]]; then
    echo "WARNING: One or more extensions failed to sync." >&2
  fi
  return "$exit_code"
}

# ── Command: shared tool store ────────────────────────────────────────────────
# Specs dispatch to the manager that owns each ecosystem. Every install runs
# inside the container and lands in the mounted store.
_tool_install() {
  local profile="$1"
  shift
  if [[ $# -eq 0 ]]; then
    echo "ERROR: piw tool install needs at least one spec." >&2
    echo "  Example: piw tool install npm:typescript uv:ruff" >&2
    exit 1
  fi
  local spec
  for spec in "$@"; do
    echo "INFO: Installing $spec into the tool store…"
    case "$spec" in
    npm:*) _in_container "$profile" npm install --global --prefix /home/pi/.local "${spec#npm:}" ;;
    uv:*) _in_container "$profile" env UV_TOOL_BIN_DIR=/home/pi/.local/bin uv tool install --force "${spec#uv:}" ;;
    cargo:*) _in_container "$profile" cargo install --root /home/pi/.local "${spec#cargo:}" ;;
    go:*) _in_container "$profile" env GOBIN=/home/pi/.local/bin go install "${spec#go:}" ;;
    *)
      echo "ERROR: Unknown tool spec '$spec'." >&2
      echo "  Known prefixes: npm:, uv:, cargo:, go:" >&2
      exit 1
      ;;
    esac
  done
}

_tool_remove() {
  local profile="$1"
  shift
  if [[ $# -eq 0 ]]; then
    echo "ERROR: piw tool remove needs at least one spec." >&2
    exit 1
  fi
  local spec
  for spec in "$@"; do
    case "$spec" in
    npm:*) _in_container "$profile" npm uninstall --global --prefix /home/pi/.local "${spec#npm:}" ;;
    uv:*) _in_container "$profile" uv tool uninstall "${spec#uv:}" ;;
    cargo:*) _in_container "$profile" cargo uninstall --root /home/pi/.local "${spec#cargo:}" ;;
    go:*)
      echo "ERROR: go install has no uninstall." >&2
      echo "  Remove the binary under $(resolve_tools_dir)/bin by hand." >&2
      exit 1
      ;;
    *)
      echo "ERROR: Unknown tool spec '$spec'." >&2
      exit 1
      ;;
    esac
  done
}

_tool_list() {
  local profile="$1"
  _in_container "$profile" sh -c '
    echo "== binaries"
    ls -1 /home/pi/.local/bin 2>/dev/null || true
    echo
    echo "== npm"
    npm ls --global --prefix /home/pi/.local --depth=0 2>/dev/null || true
    echo
    echo "== uv"
    UV_TOOL_BIN_DIR=/home/pi/.local/bin uv tool list 2>/dev/null || true
    echo
    echo "== cargo"
    cargo install --list --root /home/pi/.local 2>/dev/null || true
  '
}

# ── Command: manage the shared tool store ────────────────────────────────────
cmd_tool() {
  local profile="$1"
  shift
  local sub="${1:-list}"
  [[ $# -gt 0 ]] && shift
  case "$sub" in
  install) _tool_install "$profile" "$@" ;;
  remove) _tool_remove "$profile" "$@" ;;
  list) _tool_list "$profile" ;;
  *)
    echo "ERROR: Unknown 'piw tool' subcommand: $sub" >&2
    echo "Usage: piw tool install <spec>... | list | remove <spec>..." >&2
    exit 1
    ;;
  esac
}

# ── Command: launch pi in Docker ──────────────────────────────────────────────
cmd_launch() {
  local profile="$1"
  local workspace="$2"
  local resume="${3:-false}"
  local mode="${4:-permissive}"
  local image_tag="${IMAGE_PREFIX}:${profile}"

  validate_profile "$profile"

  # Workspace must exist
  if [[ ! -d "$workspace" ]]; then
    echo "ERROR: Workspace not found: $workspace" >&2
    exit 1
  fi

  # Resolve config dir (default: .pi/agent/ inside harness)
  local config_dir
  config_dir="$(resolve_config_dir)"
  bootstrap_config "$config_dir"
  bootstrap_permissions
  ensure_tools_dir

  # Ensure APPEND_SYSTEM.md exists
  local append_src="$SCRIPT_DIR/skills/system/workflow/APPEND_SYSTEM.md"
  if [[ ! -f "$append_src" ]]; then
    echo "WARNING: $append_src not found. Creating empty placeholder."
    mkdir -p "$(dirname "$append_src")"
    touch "$append_src"
  fi

  # ensure_pi builds the image when missing (ensure_image) and checks the
  # pi install in the config mount.
  ensure_pi "$profile" require

  # Cheap pre-exec guard: a corrupted/empty app mount that still passes the
  # version read would otherwise die inside the container with an opaque
  # exec error. Fail here with an actionable message instead.
  local pi_host
  pi_host="$(resolve_pi_host_dir)"
  if [[ ! -x "$pi_host/node_modules/.bin/pi" ]]; then
    echo "ERROR: pi CLI missing in app mount ($pi_host)." >&2
    echo "  Run 'piw update' (or delete .pi/app and retry) to repair." >&2
    exit 1
  fi

  # Build Docker env-var flags from known API keys
  local -a env_flags=()
  local known_keys=(
    SILICONFLOW_API_KEY
    FIREWORKS_API_KEY
    ANTHROPIC_API_KEY
    OPENAI_API_KEY
    DEEPSEEK_API_KEY
    GEMINI_API_KEY
    OPENROUTER_API_KEY
    HUGGINGFACE_API_KEY
    GROQ_API_KEY
    MISTRAL_API_KEY
    XAI_API_KEY
    TOGETHER_API_KEY
    AZURE_OPENAI_API_KEY
  )
  for var in "${known_keys[@]}"; do
    if [[ -n "${!var:-}" ]]; then
      env_flags+=(-e "$var")
    fi
  done

  # Git identity — pass host git config into the container
  local git_name git_email
  git_name="$(git config user.name 2>/dev/null || true)"
  git_email="$(git config user.email 2>/dev/null || true)"
  [[ -n "$git_name" ]] && env_flags+=(-e GIT_AUTHOR_NAME="$git_name")
  [[ -n "$git_email" ]] && env_flags+=(-e GIT_AUTHOR_EMAIL="$git_email")

  # Git config file mounts (optional, read-only)
  local -a git_config_volumes=()
  [[ -f "$HOME/.gitconfig" ]] && git_config_volumes+=(-v "$HOME/.gitconfig:/home/pi/.gitconfig:z,ro")
  [[ -f "$HOME/.config/git/config" ]] && git_config_volumes+=(-v "$HOME/.config/git:/home/pi/.config/git:z,ro")

  # Variant-specific skill mount (documents the active variant's toolset)
  local variant_skill="$SCRIPT_DIR/variants/$profile/SKILL.md"
  local -a variant_skill_volumes=()
  [[ -f "$variant_skill" ]] && variant_skill_volumes+=(-v "$variant_skill:/home/pi/.pi/agent/skills/variant/SKILL.md:z,ro")

  # Pi app mount (ensure_pi created it moments ago; guard anyway)
  local pi_host
  pi_host="$(resolve_pi_host_dir)"
  local -a pi_volumes=()
  [[ -d "$pi_host" ]] && pi_volumes+=(-v "$pi_host:/opt/pi:z")

  local pi_args=()
  [[ "$resume" == "true" ]] && pi_args+=(-r)
  local session_flag=""
  [[ "$resume" == "true" ]] && session_flag=" (resume mode)"

  # Validate and resolve mode config
  validate_mode "$mode"
  local mode_config
  mode_config="$(resolve_mode_config "$mode")"

  # Mode-specific Docker restrictions
  local mode_vol_suffix=""
  local tools_suffix=""
  local -a mode_docker_flags=()
  if [[ "$mode" == "readonly" ]]; then
    mode_vol_suffix=",ro"
    tools_suffix=",ro"
    mode_docker_flags+=(--network none)
  fi

  echo "INFO: Launching pi-harness ($profile) in $workspace (mode: $mode)$session_flag"
  exec docker run --rm -it \
    --add-host host.docker.internal:host-gateway \
    --user "$(id -u):$(id -g)" \
    -e HOME=/home/pi \
    -e YADM_HOME="$HOME" \
    -e PI_CODING_AGENT_DIR=/home/pi/.pi/agent \
    -e npm_config_cache=/tmp/.npm-cache \
    -e npm_config_ignore_scripts=true \
    "${env_flags[@]}" \
    "${mode_docker_flags[@]}" \
    -v "$config_dir:/home/pi/.pi/agent:z" \
    -v "$append_src:/home/pi/.pi/agent/APPEND_SYSTEM.md:z,ro" \
    -v "$SCRIPT_DIR/skills:/home/pi/.pi/agent/skills:z" \
    -v "$SCRIPT_DIR/extensions:/home/pi/.pi/agent/extensions:z" \
    -v "$SCRIPT_DIR/agents:/home/pi/.pi/agent/agents:z" \
    ${mode_config:+-v "$mode_config:/home/pi/.pi/agent/extensions/pi-permission-system/config.json:z"} \
    "${git_config_volumes[@]}" \
    "${variant_skill_volumes[@]}" \
    "${pi_volumes[@]}" \
    -v "$workspace:$workspace:z${mode_vol_suffix}" \
    -v "$(resolve_tools_dir):/home/pi/.local:z${tools_suffix}" \
    -w "$workspace" \
    "$image_tag" \
    pi "${pi_args[@]}"
}

# ── Internal: build a single variant image (no package install) ───────────────
_build_single() {
  local profile="$1"
  local no_cache="$2"
  local offline="$3"
  local variant_dir="$SCRIPT_DIR/variants/$profile"
  local image_tag="${IMAGE_PREFIX}:${profile}"

  validate_profile "$profile"
  ensure_archives "$profile" "$offline"

  local -a build_args=(-f "$variant_dir/Dockerfile" -t "$image_tag" "$SCRIPT_DIR")
  if [[ "$no_cache" == "true" ]]; then
    build_args=("--no-cache" "${build_args[@]}")
  fi

  echo "INFO: Building pi-harness:$profile…"
  docker build "${build_args[@]}"
  echo "INFO: Build complete: $image_tag"
}

# ── Command: build variant images + provision the config mount ───────────────
cmd_build() {
  local profile="$1"
  local no_cache="${2:-false}"
  local do_all="${3:-false}"
  local offline="${4:-false}"

  local -a targets=()
  if [[ "$do_all" == "true" ]]; then
    mapfile -t targets < <(variant_names)
  else
    targets=("$profile")
  fi

  for p in "${targets[@]}"; do
    echo "--- $p ---"
    _build_single "$p" "$no_cache" "$offline"
  done

  # pi is mount-level: provision once, then sync extensions per variant
  ensure_pi "${targets[0]}" require
  for p in "${targets[@]}"; do
    echo "--- $p ---"
    sync_extensions_for "$p"
  done

  cmd_generate_catalog  # refresh catalog, skills may have changed
}

# ── Command: install piw symlink into PATH ────────────────────────────────────
cmd_install() {
  local target_dir="${1:-$HOME/.local/bin}"
  local link_path="$target_dir/piw"
  local piw_path="$SCRIPT_DIR/piw"

  mkdir -p "$target_dir"

  if [[ -L "$link_path" ]]; then
    local current
    current="$(readlink "$link_path")"
    if [[ "$current" == "$piw_path" ]]; then
      echo "✓ piw already installed at $link_path"
    else
      ln -sf "$piw_path" "$link_path"
      echo "✓ Updated symlink: $link_path → $piw_path (was → $current)"
    fi
  elif [[ -f "$link_path" ]]; then
    echo "ERROR: $link_path exists and is not a symlink. Remove it first." >&2
    exit 1
  else
    ln -s "$piw_path" "$link_path"
    echo "✓ Installed: $link_path → $piw_path"
  fi

  # Seed configs (same as launch does)
  local config_dir
  config_dir="$(resolve_config_dir)"
  bootstrap_config "$config_dir"
  bootstrap_permissions

  if [[ ":$PATH:" != *":$target_dir:"* ]]; then
    echo ""
    echo "NOTE: $target_dir is not on your PATH. Add this to ~/.bashrc / ~/.zshrc:"
    echo "  export PATH=\"\$PATH:$target_dir\""
  fi

  echo ""
  echo "✓ pi-harness installed. Run 'piw' to launch."
}

# ── Command: remove piw symlink from PATH ────────────────────────────────────
cmd_uninstall() {
  local target_dir="${1:-$HOME/.local/bin}"
  local link_path="$target_dir/piw"
  local piw_path="$SCRIPT_DIR/piw"

  if [[ ! -L "$link_path" ]] && [[ ! -e "$link_path" ]]; then
    echo "✓ piw not found at $link_path (nothing to remove)"
    return
  fi

  if [[ -L "$link_path" ]]; then
    local current
    current="$(readlink "$link_path")"
    if [[ "$current" != "$piw_path" ]]; then
      echo "ERROR: $link_path points to $current, not $piw_path. Not removing." >&2
      exit 1
    fi
    rm "$link_path"
    echo "✓ Removed symlink: $link_path"
  else
    echo "ERROR: $link_path is a regular file. Remove manually." >&2
    exit 1
  fi

  local config_dir
  config_dir="$(resolve_config_dir)"
  if [[ -d "$config_dir" ]]; then
    echo ""
    echo "NOTE: Config directory still exists at $config_dir"
    echo "  Remove with: rm -rf $config_dir"
  fi
}

# ── Command: diagnose harness setup ──────────────────────────────────────────
cmd_doctor() {
  local profile="$1"
  local errors=0

  echo "pi-harness doctor — diagnosing \"$profile\" profile"
  echo ""

  # ── Docker ──
  echo "── Docker ──"
  if command -v docker &>/dev/null; then
    echo "  ✓ docker found at $(command -v docker)"
    if docker info &>/dev/null 2>&1; then
      echo "  ✓ Docker daemon is running"
    else
      echo "  ✗ Docker daemon is not running (or permission denied)"
      ((errors+=1))
    fi
  else
    echo "  ✗ docker not found on PATH"
    ((errors+=1))
  fi

  # ── Variant ──
  echo "── Variant ($profile) ──"
  local variant_dir="$SCRIPT_DIR/variants/$profile"
  if [[ -d "$variant_dir" ]]; then
    echo "  ✓ Variant directory: $variant_dir"
    if [[ -f "$variant_dir/Dockerfile" ]]; then
      echo "  ✓ Dockerfile exists"
    else
      echo "  ✗ No Dockerfile in $variant_dir"
      ((errors+=1))
    fi
  else
    echo "  ✗ Variant directory not found: $variant_dir"
    ((errors+=1))
  fi

  # ── Docker image ──
  local image_tag="${IMAGE_PREFIX}:${profile}"
  if docker image inspect "$image_tag" &>/dev/null 2>&1; then
    echo "  ✓ Docker image built: $image_tag"
  else
    echo "  ⚠ Docker image not yet built (auto-built on first launch)"
  fi

  # ── Environment ──
  echo "── Environment ──"
  if [[ -f "$SCRIPT_DIR/.env" ]]; then
    echo "  ✓ .env file exists"
    if grep -qP '^[A-Z_]+=\s*$' "$SCRIPT_DIR/.env" 2>/dev/null; then
      echo "  ⚠ Some variables in .env are empty (placeholders?)"
    fi
  else
    echo "  ⚠ .env not found (copy .env.example to .env)"
  fi

  local found_keys=0
  for var in ANTHROPIC_API_KEY OPENAI_API_KEY GEMINI_API_KEY FIREWORKS_API_KEY; do
    if [[ -n "${!var:-}" ]]; then
      echo "  ✓ $var is set"
      ((found_keys+=1))
    fi
  done
  if [[ $found_keys -eq 0 ]]; then
    echo "  ⚠ No API keys found (set at least one in .env or export it)"
  fi

  # ── Config directory ──
  echo "── Config ──"
  local config_dir
  config_dir="$(resolve_config_dir)"
  if [[ -d "$config_dir" ]]; then
    echo "  ✓ Config directory: $config_dir"
    [[ -f "$config_dir/settings.json" ]] && echo "  ✓ settings.json" || echo "  ⚠ No settings.json (seeded on first launch)"
    [[ -f "$config_dir/models.json" ]] && echo "  ✓ models.json" || echo "  ⚠ No models.json (seeded on first launch)"
  else
    echo "  ⚠ Config directory not found (created on first launch)"
  fi

  # ── Skills & Extensions ──
  echo "── Skills & Extensions ──"
  if [[ -d "$SCRIPT_DIR/skills/system/workflow" ]]; then
    echo "  ✓ Workflow skill: skills/system/workflow"
    [[ -f "$SCRIPT_DIR/skills/system/workflow/SKILL.md" ]] && echo "  ✓   SKILL.md" || echo "  ⚠   Missing SKILL.md"
    [[ -f "$SCRIPT_DIR/skills/system/workflow/APPEND_SYSTEM.md" ]] && echo "  ✓   APPEND_SYSTEM.md" || echo "  ⚠   Missing APPEND_SYSTEM.md"
  else
    echo "  ⚠ Workflow skill directory not found: skills/system/workflow"
  fi
  [[ -d "$SCRIPT_DIR/skills/system" ]] && echo "  ✓ skills/system directory" || echo "  ⚠ skills/system not found (optional)"
  [[ -d "$SCRIPT_DIR/extensions" ]] && echo "  ✓ Extensions directory" || echo "  ⚠ Extensions directory not found"

  # ── Pi (app mount) ──
  echo "── Pi (app mount .pi/app) ──"
  local pi_installed pi_latest
  pi_installed="$(_pi_installed_version "$(resolve_pi_host_dir)")"
  pi_latest="$(_npm_latest_version "$PI_NPM_PKG")"
  if [[ -n "$pi_installed" ]]; then
    echo "  ✓ pi installed: $pi_installed"
    if [[ -n "$pi_latest" && "$pi_installed" != "$pi_latest" ]]; then
      echo "  ⚠ Update available: $pi_latest (run 'piw update')"
      ((errors+=1))
    elif [[ -n "$pi_latest" ]]; then
      echo "  ✓ Latest version: $pi_latest"
    else
      echo "  ⚠ Cannot check latest version (npm unreachable?)"
    fi
  else
    echo "  ✗ pi not installed in app mount (launch piw or run 'piw update')"
    ((errors+=1))
  fi

  # ── Extensions (config-seeds manifest vs config mount) ──
  echo "── Extensions ──"
  if [[ -f "$SCRIPT_DIR/config-seeds/extensions.txt" ]]; then
    echo "  ✓ config-seeds/extensions.txt found"
    local checked=0 missing=0 outdated=0
    while IFS= read -r line; do
      line="${line/#"${line%%[![:space:]]*}"/}"
      line="${line/%"${line##*[![:space:]]}"/}"
      [[ -z "$line" ]] && continue
      [[ "$line" == \#* ]] && continue
      checked=$((checked + 1))
      local edir ever elate
      edir="$(_pkg_mount_dir "$config_dir" "$line")"
      if [[ "$line" == npm:* ]]; then
        ever="$(_pkg_installed_version "$edir")"
        if [[ -z "$ever" ]]; then
          echo "  ✗ $line (missing — run 'piw update')"
          ((missing+=1))
        else
          elate="$(_npm_latest_version "${line#npm:}")"  # strip pi's npm: URI scheme
          if [[ -n "$elate" && "$ever" != "$elate" ]]; then
            echo "  ⚠ $line $ever → $elate (run 'piw update')"
            ((outdated+=1))
          else
            echo "  ✓ $line $ever"
          fi
        fi
      elif [[ -z "$edir" || ! -d "$edir" ]]; then
        echo "  ✗ $line (missing — run 'piw update')"
        ((missing+=1))
      else
        echo "  ✓ $line (git)"
      fi
    done <"$SCRIPT_DIR/config-seeds/extensions.txt"
    echo "  Extensions: $((checked - missing))/$checked current, $outdated outdated"
    if [[ "$missing" -gt 0 || "$outdated" -gt 0 ]]; then
      echo "  ⚠ Run 'piw update' to sync extensions"
    fi
  else
    echo "  ⚠ No extensions.txt found"
  fi

  # ── Build archives ──
  echo "── Build archives ──"
  local missing_archives=0
  for file in $(_profile_archives "$profile"); do
    if [[ -f "$SCRIPT_DIR/build/archives/$file" ]]; then
      echo "  ✓ $file"
    else
      echo "  ✗ $file (missing — fetch manually, see build/README.md)"
      ((missing_archives+=1))
    fi
  done
  if [[ "$missing_archives" -eq 0 ]]; then
    echo "  ✓ All build archives present for $profile"
  fi

  # ── Skills catalog freshness ──
  echo "── Skills catalog ──"
  local catalog_script="$SCRIPT_DIR/skills/generate-catalog.sh"
  local catalog_file="$SCRIPT_DIR/skills/catalog.md"
  if [[ -f "$catalog_script" ]] && [[ -f "$catalog_file" ]]; then
    local tmp_catalog
    tmp_catalog="$(mktemp)"
    bash "$catalog_script" "$tmp_catalog" &>/dev/null
    if diff -q "$tmp_catalog" "$catalog_file" &>/dev/null; then
      echo "  ✓ skills/catalog.md is fresh"
    else
      echo "  ⚠ skills/catalog.md is stale (run 'piw generate-catalog')"
      ((errors+=1))
    fi
    rm -f "$tmp_catalog"
  elif [[ ! -f "$catalog_script" ]]; then
    echo "  ⚠ generate-catalog.sh not found"
  else
    echo "  ⚠ skills/catalog.md not found"
  fi

  # ── Repository ──
  echo "── Repository ──"
  if git -C "$SCRIPT_DIR" rev-parse --git-dir &>/dev/null 2>&1; then
    echo "  ✓ Git repository"
    if [[ -z "$(git -C "$SCRIPT_DIR" status --porcelain 2>/dev/null)" ]]; then
      echo "  ✓ Working tree clean"
    else
      echo "  ⚠ Uncommitted changes"
    fi
  else
    echo "  ⚠ Not a git repository"
  fi

  # ── Summary ──
  echo ""
  if [[ $errors -eq 0 ]]; then
    echo "✓ All checks passed. Run 'piw' to launch."
  else
    echo "✗ $errors issue(s) found. Review the items above."
    return 1
  fi
}

# ── Command: regenerate skills catalog ────────────────────────────────────────
cmd_generate_catalog() {
  local script="$SCRIPT_DIR/skills/generate-catalog.sh"
  if [[ ! -f "$script" ]]; then
    echo "ERROR: generate-catalog.sh not found at $script" >&2
    exit 1
  fi
  echo "Regenerating skills catalog…"
  bash "$script"
}

# ── Command: update harness, images, pi, and extensions ──────────────────────
cmd_update() {
  local profile="$1"
  local no_cache="${2:-false}"
  local do_all="${3:-false}"
  local build_only="${4:-false}"
  local install_only="${5:-false}"
  local offline="${6:-false}"
  local dry_run="${7:-false}"
  local force="${8:-false}"

  # 1) Pull harness updates (ff-only; never stash). Fail → abort.
  if [[ "$dry_run" != "true" ]]; then
    if git -C "$SCRIPT_DIR" remote -v &>/dev/null; then
      echo "INFO: Pulling harness updates from git…"
      if ! git -C "$SCRIPT_DIR" pull --ff-only 2>&1; then
        echo "ERROR: Git pull failed." >&2
        echo "  Local changes overlap incoming updates, or the remote diverged." >&2
        echo "  Commit or unshelve locally, run 'git pull --ff-only' manually," >&2
        echo "  then retry." >&2
        return 1
      fi
    else
      echo "INFO: No git remote configured. Skipping pull."
    fi
  else
    echo "INFO: (dry-run) Skipping git pull."
  fi

  # Determine target variant(s)
  local -a targets=()
  if [[ "$do_all" == "true" ]]; then
    mapfile -t targets < <(variant_names)
  else
    targets=("$profile")
  fi

  # 2) Rebuild images
  if [[ "$install_only" != "true" ]]; then
    for p in "${targets[@]}"; do
      echo "--- $p ---"
      if [[ "$dry_run" == "true" ]]; then
        echo "(dry-run) Would rebuild pi-harness:$p"
        continue
      fi
      _build_single "$p" "$no_cache" "$offline"
    done
  fi

  # 3) Mount-level maintenance: pi (upgrade) + extensions (sync)
  if [[ "$build_only" != "true" ]]; then
    ensure_pi "${targets[0]}" upgrade "$dry_run"
    for p in "${targets[@]}"; do
      echo "--- $p ---"
      sync_extensions_for "$p" "$force" "$dry_run"
    done
  fi

  echo ""
  if [[ "$dry_run" == "true" ]]; then
    echo "✓ (dry-run) Nothing executed. Run without --dry-run to apply."
  else
    cmd_generate_catalog  # refresh catalog after git pull may have changed skills
    echo "✓ Update complete. Run 'piw' to launch."
  fi
}

# ── Main ──────────────────────────────────────────────────────────────────────
load_env

PROFILE="${PIW_DEFAULT_PROFILE:-core}"
COMMAND=""
NO_CACHE="false"
RESUME="false"
DO_ALL="false"
FORCE="false"
DRY_RUN="false"
BUILD_ONLY="false"
INSTALL_ONLY="false"
OFFLINE="false"
MODE="${PIW_MODE:-permissive}"
POSITIONAL=()

while [[ $# -gt 0 ]]; do
  case "$1" in
  --profile)
    if [[ -z "${2:-}" ]]; then
      echo "ERROR: --profile requires an argument" >&2
      exit 1
    fi
    PROFILE="$2"
    shift 2
    ;;
  --no-cache)
    NO_CACHE="true"
    shift
    ;;
  --offline)
    OFFLINE="true"
    shift
    ;;
  -r | --resume)
    RESUME="true"
    shift
    ;;
  --all)
    DO_ALL="true"
    shift
    ;;
  --force)
    FORCE="true"
    shift
    ;;
  --dry-run)
    DRY_RUN="true"
    shift
    ;;
  --build-only)
    BUILD_ONLY="true"
    shift
    ;;
  --install-only)
    INSTALL_ONLY="true"
    shift
    ;;
  --mode)
    if [[ -z "${2:-}" ]]; then
      echo "ERROR: --mode requires an argument" >&2
      exit 1
    fi
    MODE="$2"
    shift 2
    ;;
  --install)
    COMMAND="install"
    shift
    ;;
  --uninstall)
    COMMAND="uninstall"
    shift
    ;;
  --help | -h)
    show_help
    ;;
  build | update | install | uninstall | doctor | generate-catalog | tool)
    COMMAND="$1"
    shift
    ;;
  -*)
    echo "ERROR: Unknown option: $1" >&2
    echo "Usage: piw [--profile <name>] [--resume|-r] [--install|--uninstall] [--help]" >&2
    exit 1
    ;;
  *)
    POSITIONAL+=("$1")
    shift
    ;;
  esac
done

# Validate flag combinations
if [[ "$BUILD_ONLY" == "true" && "$INSTALL_ONLY" == "true" ]]; then
  echo "ERROR: --build-only and --install-only are mutually exclusive" >&2
  exit 1
fi

case "$COMMAND" in
build)
  cmd_build "${POSITIONAL[0]:-$PROFILE}" "$NO_CACHE" "$DO_ALL" "$OFFLINE"
  ;;
update)
  cmd_update "${POSITIONAL[0]:-$PROFILE}" "$NO_CACHE" "$DO_ALL" "$BUILD_ONLY" "$INSTALL_ONLY" "$OFFLINE" "$DRY_RUN" "$FORCE"
  ;;
install)
  cmd_install "${POSITIONAL[0]:-}"
  ;;
uninstall)
  cmd_uninstall "${POSITIONAL[0]:-}"
  ;;
doctor)
  cmd_doctor "${POSITIONAL[0]:-$PROFILE}"
  ;;
generate-catalog)
  cmd_generate_catalog
  ;;
tool)
  cmd_tool "$PROFILE" "${POSITIONAL[@]}"
  ;;
*)
  cmd_launch "$PROFILE" "${POSITIONAL[0]:-$(pwd)}" "$RESUME" "$MODE"
  ;;
esac

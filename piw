#!/usr/bin/env bash
# piw - launch the pi coding agent in Docker
#
# Model:
#   The Docker image is tooling and isolation only. pi lives in its own
#   app mount (.local/app), and extensions live inside the agent directory
#   (.local/agent/). Both update without image rebuilds. `piw update` is the
#   one command that brings everything current.
#
# Usage:
#   piw [<path>]                 Launch in the current directory or <path>
#     --mode <name>              Permission mode (permissive, restricted, readonly)
#     -r, --resume               Launch with the session picker
#   piw build                    Build the default image and the layer image
#     --no-cache                 Full rebuild (ignore the Docker cache)
#     --dry-run                  Print the generated plan (no executions)
#   piw tool install <spec>...   Install tools into the shared store
#   piw tool remove <spec>...    Remove tools from the shared store
#   piw tool list                List tools in the shared store
#   piw layer add <name|apt:...> Adopt a shipped layer, or scaffold a new one
#   piw layer remove <name>      Remove a layer from the manifest
#   piw layer list               List shipped and active layers
#   piw layer show <name>        Show a layer's contents
#   piw layer update <name>      Update an adopted layer
#     --replace                  Overwrite local changes to an adopted layer
#   piw doctor                   Diagnose the harness
#   piw link [dir]               Put piw on PATH (symlink into dir)
#   piw unlink [dir]             Take piw off PATH (remove the symlink)
#   piw generate-catalog         Regenerate the skills catalog
#   piw update                   Pull, report drift, rebuild, and update pi
#     --no-cache                 Full rebuild (ignore the Docker cache)
#     --force                    Force the update
#     --dry-run                  Show what would change (no executions)
#   piw --version                Print the version
#   piw --help                   Show this help
#
#   link and unlink put piw on or off PATH. Each one makes or removes a
#   symlink to this script in a directory such as ~/.local/bin.
#
# Environment:
#   Secrets are read from .local/env (if present) and passed to the
#   container with --env-file. See .env.example for the supported variables.
#
#   PI_CONFIG_DIR   Override the pi state directory (default: .local/agent)
#   PI_PI_DIR       Override the pi app directory (default: .local/app)
#   PI_TOOLS_DIR    Override the tool store directory (default: .local/store)
#   PIW_CONF        Override the layer manifest (default: .local/piw.conf)
#   PIW_MISE_CONFIG Override the mise config (default: .local/mise/config.toml)
#   PIW_MODE        Permission mode (permissive, restricted, readonly)
#
set -euo pipefail

# ── Constants ─────────────────────────────────────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
IMAGE_PREFIX="piw"
PIW_VERSION="0.1.0"

# ── Help ──────────────────────────────────────────────────────────────────────
show_help() {
  # Print the header comment block dynamically (lines from after the
  # shebang up to the first non-comment line), so the help text can
  # grow without renumbering a hardcoded range.
  awk '
    NR == 1 { next }
    /^#/ {
      line = $0
      sub(/^# ?/, "", line)
      print line
      next
    }
    { exit }
  ' "$0"
  exit 0
}

# ── Utility: validate mode exists ────────────────────────────────────────────
validate_mode() {
  local mode="$1"
  if [[ "$mode" == "permissive" ]]; then
    return 0
  fi
  local config_dir
  config_dir="$(resolve_config_dir)"
  local seed_config="$SCRIPT_DIR/seed/permissions/config.$mode.json"
  local live_config="$config_dir/extensions/pi-permission-system/config.$mode.json"
  if [[ ! -f "$seed_config" && ! -f "$live_config" ]]; then
    echo "ERROR: Unknown mode '$mode'." >&2
    echo "  Available modes:" >&2
    local f name
    local -a modes=()
    for f in "$SCRIPT_DIR"/seed/permissions/config.*.json \
             "$config_dir"/extensions/pi-permission-system/config.*.json; do
      [[ -f "$f" ]] || continue
      name="$(basename "$f" .json)"
      name="${name#config.}"
      [[ " ${modes[*]} " == *" $name "* ]] && continue
      modes+=("$name")
    done
    for name in "${modes[@]}"; do
      echo "    - $name" >&2
    done
    exit 1
  fi
}

# ── Utility: resolve mode config path (empty for permissive) ─────────────────
resolve_mode_config() {
  local mode="$1"
  if [[ "$mode" == "permissive" ]]; then
    echo ""
    return
  fi
  echo "$(resolve_config_dir)/extensions/pi-permission-system/config.$mode.json"
}

# ── Utility: resolve pi config directory ─────────────────────────────────────
resolve_config_dir() {
  if [[ "${PI_CONFIG_DIR:-}" = /* ]]; then
    echo "$PI_CONFIG_DIR"
  else
    echo "$SCRIPT_DIR/${PI_CONFIG_DIR:-.local/agent}"
  fi
}

# ── Utility: resolve the layer manifest path ─────────────────────────────────
resolve_piw_conf() {
  # Mirror the other resolvers: an absolute PIW_CONF wins; otherwise the
  # value is resolved against the harness root.
  if [[ "${PIW_CONF:-}" = /* ]]; then
    echo "$PIW_CONF"
  else
    echo "$SCRIPT_DIR/${PIW_CONF:-.local/piw.conf}"
  fi
}

# ── Utility: resolve the mise config path ────────────────────────────────────
resolve_mise_config() {
  # Mirror the other resolvers: an absolute PIW_MISE_CONFIG wins; otherwise
  # the value is resolved against the harness root.
  if [[ "${PIW_MISE_CONFIG:-}" = /* ]]; then
    echo "$PIW_MISE_CONFIG"
  else
    echo "$SCRIPT_DIR/${PIW_MISE_CONFIG:-.local/mise/config.toml}"
  fi
}

# ── Utility: bootstrap pi config on the host ─────────────────────────────────
bootstrap_config() {
  local config_dir="$1"
  mkdir -p "$config_dir"

  # Seed models.json
  if [[ ! -f "$config_dir/models.json" ]] && [[ -f "$SCRIPT_DIR/seed/models.json" ]]; then
    cp "$SCRIPT_DIR/seed/models.json" "$config_dir/models.json"
    echo "INFO: Seeded $config_dir/models.json from harness defaults."
    echo "      Edit it there to tweak models or add providers."
  fi

  # Seed settings.json
  if [[ ! -f "$config_dir/settings.json" ]] && [[ -f "$SCRIPT_DIR/seed/settings.json" ]]; then
    cp "$SCRIPT_DIR/seed/settings.json" "$config_dir/settings.json"
    echo "INFO: Seeded $config_dir/settings.json from harness defaults."
  fi
}

# ── Utility: seed permission configs into the live extension directory ───────
# The live extension directory is user state under the agent directory.
# Shipped policies live in seed/permissions/ and are copied in only when absent.
bootstrap_permissions() {
  local seed_dir="$SCRIPT_DIR/seed/permissions"
  local live_dir
  live_dir="$(resolve_config_dir)/extensions/pi-permission-system"

  mkdir -p "$live_dir"

  [[ -d "$seed_dir" ]] || return 0

  local seed name seeded="false"
  for seed in "$seed_dir"/config*.json; do
    [[ -f "$seed" ]] || continue
    name="$(basename "$seed")"
    if [[ ! -f "$live_dir/$name" ]]; then
      cp "$seed" "$live_dir/$name"
      seeded="true"
    fi
  done
  if [[ "$seeded" == "true" ]]; then
    echo "INFO: Seeded permission configs into $live_dir"
  fi
}

# ── Utility: seed the starter manifest and mise config (never overwrite) ─────
# Both files are user state. Write each one only when the live file is absent.
# An established user keeps their file. A new user starts from a working copy.
bootstrap_starters() {
  local piw_conf mise_config
  piw_conf="$(resolve_piw_conf)"
  mise_config="$(resolve_mise_config)"

  if [[ ! -f "$piw_conf" ]] && [[ -f "$SCRIPT_DIR/seed/piw.conf" ]]; then
    mkdir -p "$(dirname "$piw_conf")"
    cp "$SCRIPT_DIR/seed/piw.conf" "$piw_conf"
    echo "INFO: Seeded $piw_conf from harness defaults."
  fi
  if [[ ! -f "$mise_config" ]] && [[ -f "$SCRIPT_DIR/seed/mise/config.toml" ]]; then
    mkdir -p "$(dirname "$mise_config")"
    cp "$SCRIPT_DIR/seed/mise/config.toml" "$mise_config"
    echo "INFO: Seeded $mise_config from harness defaults."
  fi
}

# ── Utility: parse the layer manifest into section<TAB>entry lines ───────────
# POSIX awk. The manifest is line-oriented:
#   - `#` starts a comment at the start of a line or after whitespace
#   - blank lines and CRLF are tolerated
#   - `[name]` starts a section; repeated sections merge
#   - any other non-blank line is an entry
# A malformed section header or an entry before the first section stops the
# parse. The parser names the file and the line on stderr and exits non-zero.
parse_piw_conf() {
  awk '
    function trim(s) {
      sub(/^[[:space:]]+/, "", s)
      sub(/[[:space:]]+$/, "", s)
      return s
    }
    BEGIN { section = "" }
    {
      line = $0
      if (line ~ /^[[:space:]]*#/) next
      if (line ~ /^[[:space:]]*$/) next
      if (line ~ /^[[:space:]]*\[/) {
        body = line
        sub(/[[:space:]]+#.*$/, "", body)
        body = trim(body)
        if (body !~ /^\[[A-Za-z0-9_.-]+\]$/) {
          print FILENAME ":" NR ": malformed section header" > "/dev/stderr"
          exit 2
        }
        section = substr(body, 2, length(body) - 2)
        next
      }
      body = line
      sub(/[[:space:]]+#.*$/, "", body)
      body = trim(body)
      if (body == "") next
      if (section == "") {
        print FILENAME ":" NR ": entry before any section" > "/dev/stderr"
        exit 2
      }
      print section "\t" body
    }
  ' "$(resolve_piw_conf)"
}

# ── Utility: read a layer's apt file into one package per line ───────────────
# `#` comments and blank lines are ignored. A package name never contains `#`,
# so an inline comment is stripped.
_layer_apt_packages() {
  local file="$1"
  [[ -f "$file" ]] || return 0
  awk '
    {
      line = $0
      sub(/[[:space:]]*#.*$/, "", line)
      gsub(/^[[:space:]]+/, "", line)
      gsub(/[[:space:]]+$/, "", line)
    }
    line != "" { print line }
  ' "$file"
}

# ── Utility: read a layer's archives file into one line per archive ──────────
# Each line is `<url> <sha256> <destination>`. Blank lines and full-line `#`
# comments are ignored. Inline comments are not stripped, because a URL may
# contain `#`.
_layer_archives() {
  local file="$1"
  [[ -f "$file" ]] || return 0
  awk '
    {
      line = $0
      gsub(/^[[:space:]]+/, "", line)
      gsub(/[[:space:]]+$/, "", line)
    }
    line == "" || line ~ /^#/ { next }
    { print line }
  ' "$file"
}

# ── Utility: resolve the [layers] section into ordered build steps ───────────
# Output, one step per line, tab-separated:
#   apt<TAB><pkg> <pkg>...
#   run<TAB><name><TAB><absolute layer directory>
# A missing manifest or a missing `run:` directory stops here, before Docker,
# and names the path. A missing install.sh is not an error: the script is
# optional. Unknown prefixes are an error, never a silent skip.
resolve_layers() {
  local conf
  conf="$(resolve_piw_conf)"

  if [[ ! -f "$conf" ]]; then
    echo "ERROR: Layer manifest not found: $conf" >&2
    echo "  Run 'piw link' or launch piw to seed the starter manifest." >&2
    return 1
  fi

  local parsed
  if ! parsed="$(parse_piw_conf)"; then
    return 1
  fi

  local layers_dir="$SCRIPT_DIR/.local/layers"
  local section entry name dir
  while IFS=$'\t' read -r section entry; do
    [[ "$section" == "layers" ]] || continue
    case "$entry" in
    apt:*)
      local pkgs="${entry#apt:}"
      if [[ -z "${pkgs// /}" ]]; then
        echo "ERROR: Empty [layers] entry '$entry' in $conf." >&2
        return 1
      fi
      printf 'apt\t%s\n' "$pkgs"
      ;;
    run:*)
      name="${entry#run:}"
      if [[ -z "$name" ]]; then
        echo "ERROR: Empty [layers] entry '$entry' in $conf." >&2
        return 1
      fi
      if [[ ! "$name" =~ ^[A-Za-z0-9_.-]+$ ]]; then
        echo "ERROR: Invalid layer name '$name' in $conf." >&2
        echo "  A layer name uses letters, digits, dot, dash, and underscore." >&2
        return 1
      fi
      dir="$layers_dir/$name"
      if [[ ! -d "$dir" ]]; then
        echo "ERROR: Layer '$name' not found: $dir" >&2
        echo "  Declared as '$entry' in $conf." >&2
        return 1
      fi
      printf 'run\t%s\t%s\n' "$name" "$dir"
      ;;
    *)
      echo "ERROR: Unknown [layers] entry '$entry' in $conf." >&2
      echo "  Use 'apt:<pkg> [<pkg>...]' or 'run:<name>'." >&2
      return 1
      ;;
    esac
  done <<<"$parsed"
}

# ── Utility: compose the active layers into a Dockerfile on stdout ───────────
# Consecutive apt declarations coalesce into one apt-get install. Every other
# step is emitted in the declared order. The plan never touches disk.
compose_plan() {
  local steps
  if ! steps="$(resolve_layers)"; then
    return 1
  fi

  local -a ops=()
  local kind name dir pkg line
  while IFS=$'\t' read -r kind name dir; do
    case "$kind" in
    apt)
      local -a manifest_pkgs=()
      read -r -a manifest_pkgs <<<"$name"
      for pkg in "${manifest_pkgs[@]}"; do
        [[ -n "$pkg" ]] && ops+=("apt|$pkg")
      done
      ;;
    run)
      while IFS= read -r pkg; do
        [[ -n "$pkg" ]] && ops+=("apt|$pkg")
      done < <(_layer_apt_packages "$dir/apt")
      while IFS= read -r line; do
        [[ -n "$line" ]] && ops+=("archive|$dir/archives|$line")
      done < <(_layer_archives "$dir/archives")
      if [[ -f "$dir/install.sh" ]]; then
        ops+=("layer|$name")
      fi
      ;;
    esac
  done <<<"$steps"

  # ADD --checksum needs syntax 1.6 or later. The directive does not carry
  # over from the root Dockerfile, so the generated plan states it too.
  printf '# syntax=docker/dockerfile:1.6\n'
  printf 'FROM %s:default\n' "$IMAGE_PREFIX"

  local i=0 n=${#ops[@]} op otype
  while [[ $i -lt $n ]]; do
    op="${ops[$i]}"
    otype="${op%%|*}"
    case "$otype" in
    apt)
      local -a pkgs=()
      while [[ $i -lt $n && "${ops[$i]}" == apt\|* ]]; do
        pkgs+=("${ops[$i]#apt|}")
        ((i += 1))
      done
      printf '\n# apt\n'
      printf 'RUN apt-get update \\\n'
      printf ' && apt-get install -y --no-install-recommends \\\n'
      for pkg in "${pkgs[@]}"; do
        printf '        %s \\\n' "$pkg"
      done
      printf ' && rm -rf /var/lib/apt/lists/*\n'
      ;;
    archive)
      ((i += 1))
      local afile aline url sha dest
      afile="${op#archive|}"
      afile="${afile%%|*}"
      aline="${op#archive|}"
      aline="${aline#*|}"
      local -a afields=()
      read -r -a afields <<<"$aline"
      if [[ ${#afields[@]} -ne 3 ]]; then
        echo "ERROR: Malformed archive line in $afile: $aline" >&2
        echo "  Expected: <url> <sha256> <destination>" >&2
        return 1
      fi
      url="${afields[0]}"
      sha="${afields[1]}"
      dest="${afields[2]}"
      if [[ -z "$url" || -z "$sha" || -z "$dest" ]]; then
        echo "ERROR: Malformed archive line in $afile: $aline" >&2
        echo "  Expected: <url> <sha256> <destination>" >&2
        return 1
      fi
      printf '\n# archive\n'
      printf 'ADD --checksum=sha256:%s %s %s\n' "$sha" "$url" "$dest"
      ;;
    layer)
      ((i += 1))
      name="${op#layer|}"
      printf '\n# layer %s\n' "$name"
      printf 'COPY %s/ /tmp/piw-layer-%s/\n' "$name" "$name"
      printf 'RUN bash /tmp/piw-layer-%s/install.sh \\\n' "$name"
      printf ' && rm -rf /tmp/piw-layer-%s\n' "$name"
      ;;
    esac
  done
}

# ── Utility: hash the build plan and every build input ───────────────────────
# Covers the generated Dockerfile, the root Dockerfile, and every file of every
# active layer. The image label written at build time is the only record.
plan_hash() {
  if [[ ! -f "$SCRIPT_DIR/Dockerfile" ]]; then
    echo "ERROR: Dockerfile not found at $SCRIPT_DIR/Dockerfile" >&2
    return 1
  fi

  local steps plan
  if ! steps="$(resolve_layers)"; then
    return 1
  fi
  if ! plan="$(compose_plan)"; then
    return 1
  fi

  local kind name dir f rel
  {
    printf '== plan ==\n%s\n' "$plan"
    printf '== root Dockerfile ==\n'
    cat "$SCRIPT_DIR/Dockerfile"
    while IFS=$'\t' read -r kind name dir; do
      [[ "$kind" == "run" ]] || continue
      printf '== layer %s ==\n' "$name"
      while IFS= read -r -d '' f; do
        rel="${f#"$dir"/}"
        printf -- '-- %s --\n' "$rel"
        cat "$f"
      done < <(find "$dir" \( -type f -o -type l \) -print0 | LC_ALL=C sort -z)
    done <<<"$steps"
  } | sha256sum | awk '{print $1}'
}

# ── Utility: hash the root Dockerfile ────────────────────────────────────────
# The default image has no layer plan; its only build input is the root
# Dockerfile. The hash is written as the piw.plan label on the default build.
default_plan_hash() {
  if [[ ! -f "$SCRIPT_DIR/Dockerfile" ]]; then
    echo "ERROR: Dockerfile not found at $SCRIPT_DIR/Dockerfile" >&2
    return 1
  fi
  sha256sum "$SCRIPT_DIR/Dockerfile" | awk '{print $1}'
}

# ── Utility: the image a launch uses, decided by the manifest ────────────────
# A manifest with any layer entry needs the composed image. Otherwise the
# default image is used. A missing manifest counts as no layers.
launch_image() {
  local steps=""
  steps="$(resolve_layers 2>/dev/null || true)"
  if [[ -n "$steps" ]]; then
    echo "${IMAGE_PREFIX}:local"
  else
    echo "${IMAGE_PREFIX}:default"
  fi
}

# ── Utility: ensure the default Docker image exists ──────────────────────────
ensure_image() {
  local dry_run="${1:-false}"
  local image_tag="${IMAGE_PREFIX}:default"
  if ! docker image inspect "$image_tag" &>/dev/null; then
    if [[ "$dry_run" == "true" ]]; then
      echo "INFO: (dry-run) Image '$image_tag' is missing - would build."
      return 0
    fi
    # Build through _build_single, so the piw.plan label is written. Without
    # the label the staleness check would refuse the image it just built.
    _build_single "false"
  fi
}

# ── Utility: pi app dir (host side) ─────────────────────────────────────────
PI_MOUNT_PREFIX="/opt/pi"
PI_NPM_PKG="@earendil-works/pi-coding-agent"

resolve_pi_host_dir() {
  # Mirror resolve_config_dir: an absolute PI_PI_DIR wins; otherwise the
  # harness owns the app directory under .local/.
  if [[ "${PI_PI_DIR:-}" = /* ]]; then
    echo "$PI_PI_DIR"
  else
    echo "$SCRIPT_DIR/${PI_PI_DIR:-.local/app}"
  fi
}

# ── Utility: resolve the shared tool store directory ─────────────────────────
resolve_tools_dir() {
  # Mirror the other resolvers: an absolute PI_TOOLS_DIR wins; otherwise the
  # harness owns the store under .local/.
  if [[ "${PI_TOOLS_DIR:-}" = /* ]]; then
    echo "$PI_TOOLS_DIR"
  else
    echo "$SCRIPT_DIR/${PI_TOOLS_DIR:-.local/store}"
  fi
}

# ── Utility: create the .local/ namespace before Docker can, as the user ─────
# A missing bind-mount source is created by Docker as root:root, and the host
# user cannot then write it. Create every namespace path here, as the user.
ensure_local_namespace() {
  mkdir -p "$(resolve_config_dir)"
  mkdir -p "$(resolve_tools_dir)/bin"
  mkdir -p "$(resolve_pi_host_dir)"
  mkdir -p "$SCRIPT_DIR/.local/mise"
  mkdir -p "$SCRIPT_DIR/.local/layers"
  mkdir -p "$SCRIPT_DIR/.local/agents/skills"
}

# ── Utility: the single container seam ───────────────────────────────────────
# Every container invocation in piw goes through here, so the mount map, the
# environment, and the user identity are stated once. A caller names only what
# it needs; it never assembles a `-v`, `--env-file`, `--network`, or `--user`
# argument itself.
#
#   --workspace <dir>  Mount the workspace at the same path and use it as the
#                      working directory. Read-only in readonly mode.
#   --app              Mount the pi install (.local/app) at /opt/pi.
#   --mode <name>      Permission mode (default: permissive). In readonly mode
#                      the workspace, the store, the mise config, and the
#                      Agent Skills directory are read-only, and the run has
#                      no network. The agent directory stays read-write.
#   --interactive      Add -it.
#   --                 End of options. The rest is the container command.
container_run() {
  local workspace="" mode="permissive" interactive="false" secrets="false"
  local image="${IMAGE_PREFIX}:default"
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --workspace)
      workspace="${2:?container_run: --workspace needs a directory}"
      shift 2
      ;;
    --mode)
      mode="${2:?container_run: --mode needs a name}"
      shift 2
      ;;
    --image)
      image="${2:?container_run: --image needs a tag}"
      shift 2
      ;;
    --secrets)
      secrets="true"
      shift
      ;;
    --interactive)
      interactive="true"
      shift
      ;;
    --)
      shift
      break
      ;;
    *)
      echo "ERROR: container_run: unknown option: $1" >&2
      return 2
      ;;
    esac
  done

  ensure_local_namespace

  local append_src="$SCRIPT_DIR/skills/system/workflow/APPEND_SYSTEM.md"
  if [[ ! -f "$append_src" ]]; then
    echo "ERROR: $append_src not found. The harness tree is incomplete." >&2
    return 1
  fi

  # Read-only mode restricts the project and its store, never pi's own state.
  # pi must write sessions, auth, and extension logs to the agent directory.
  local store_mode="" mise_mode="" agents_mode="" workspace_mode=""
  local -a mode_flags=()
  if [[ "$mode" == "readonly" ]]; then
    store_mode=",ro"
    mise_mode=",ro"
    agents_mode=",ro"
    workspace_mode=",ro"
    mode_flags+=(--network none)
  fi

  # The git identity is part of the user identity, so it lives here too.
  local git_name git_email
  git_name="$(git config user.name 2>/dev/null || true)"
  git_email="$(git config user.email 2>/dev/null || true)"

  local -a args=(--rm)
  [[ "$interactive" == "true" ]] && args+=(-it)
  args+=(
    --add-host host.docker.internal:host-gateway
    --user "$(id -u):$(id -g)"
    -e HOME=/home/pi
    -e YADM_HOME="$HOME"
    -e PI_CODING_AGENT_DIR=/home/pi/.pi/agent
    -e npm_config_cache=/tmp/.npm-cache
    -e npm_config_ignore_scripts=true
  )
  [[ "$secrets" == "true" && -f "$SCRIPT_DIR/.local/env" ]] && args+=(--env-file "$SCRIPT_DIR/.local/env")
  [[ -n "$git_name" ]] && args+=(-e GIT_AUTHOR_NAME="$git_name")
  [[ -n "$git_email" ]] && args+=(-e GIT_AUTHOR_EMAIL="$git_email")
  args+=("${mode_flags[@]}")

  # Base mounts. The order follows the mount map in issue #24.
  args+=(-v "$(resolve_config_dir):/home/pi/.pi/agent:z")
  args+=(-v "$(resolve_tools_dir):/home/pi/.local:z${store_mode}")
  args+=(-v "$(dirname "$(resolve_mise_config)"):/home/pi/.config/mise:z${mise_mode}")
  args+=(-v "$(resolve_pi_host_dir):/opt/pi:z")
  args+=(-v "$SCRIPT_DIR/.local/agents/skills:/home/pi/.agents/skills:z${agents_mode}")
  args+=(-v "$SCRIPT_DIR/skills:/home/pi/.pi/agent/skills:z,ro")
  args+=(-v "$SCRIPT_DIR/agents:/home/pi/.pi/agent/agents:z,ro")
  args+=(-v "$append_src:/home/pi/.pi/agent/APPEND_SYSTEM.md:z,ro")

  local mode_config
  mode_config="$(resolve_mode_config "$mode")"
  if [[ -n "$mode_config" ]]; then
    args+=(-v "$mode_config:/home/pi/.pi/agent/extensions/pi-permission-system/config.json:z,ro")
  fi

  [[ -n "$workspace" ]] && args+=(-v "$workspace:$workspace:z${workspace_mode}")

  # Optional host git config, read-only.
  [[ -f "$HOME/.gitconfig" ]] && args+=(-v "$HOME/.gitconfig:/home/pi/.gitconfig:z,ro")
  [[ -f "$HOME/.config/git/config" ]] && args+=(-v "$HOME/.config/git:/home/pi/.config/git:z,ro")

  # The layer tree is always read-only: a launch may read it, never write it.
  args+=(-v "$SCRIPT_DIR/.local/layers:/opt/piw/layers:z,ro")

  [[ -n "$workspace" ]] && args+=(-w "$workspace")

  args+=("$image")
  args+=("$@")

  # An interactive launch replaces the shell, so signals and the exit code
  # pass straight to docker. Every other caller runs docker as a child.
  if [[ "$interactive" == "true" ]]; then
    exec docker run "${args[@]}"
  fi
  docker run "${args[@]}"
}

# ── Utility: run a command inside the harness image ──────────────────────────
# The image is the stable environment. Tool actions run here, never through a
# host package manager. Every invocation goes through the container seam.
_in_container() {
  container_run -- "$@"
}

# ── Utility: installed pi version (host-side read from the app dir) ─────────
_pi_installed_version() {
  local pi_host="$1"
  local pkg_json="$pi_host/node_modules/@earendil-works/pi-coding-agent/package.json"
  if [[ ! -f "$pkg_json" ]]; then
    echo ""
    return
  fi
  sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$pkg_json" | head -1
}

# ── Utility: latest version from npm (host npm, else container npm) ──────────
_npm_latest_version() {
  local spec="$1"
  if command -v npm &>/dev/null 2>&1; then
    npm view "$spec" version 2>/dev/null | tail -1 || true
  else
    container_run -- npm view "$spec" version 2>/dev/null | tail -1 || true
  fi
}

# ── Utility: ensure pi is present in the config mount ────────────────────────
# mode: require  — install if missing; never check the registry
#       upgrade  — bring to latest when npm is reachable, keep otherwise
ensure_pi() {
  local mode="${1:-require}"
  local dry_run="${2:-false}"
  local force="${3:-false}"
  local installed latest pi_host

  ensure_image "$dry_run"

  pi_host="$(resolve_pi_host_dir)"
  mkdir -p "$pi_host"

  installed="$(_pi_installed_version "$pi_host")"

  # require mode stays offline: pi exists, so there is nothing to do. pi
  # reports its own updates.
  if [[ "$mode" == "require" && -n "$installed" ]]; then
    echo "INFO: pi $installed present."
    return 0
  fi

  # The install path and upgrade mode need the published version.
  latest="$(_npm_latest_version "$PI_NPM_PKG")"

  if [[ -n "$installed" && -z "$latest" ]]; then
    echo "INFO: pi $installed present (offline — cannot check npm)."
    return 0
  fi
  if [[ "$mode" == "upgrade" && "$force" != "true" && -n "$installed" && "$installed" == "$latest" ]]; then
    echo "INFO: pi $installed is current."
    return 0
  fi
  if [[ -z "$installed" && -z "$latest" ]]; then
    echo "ERROR: pi is not installed and npm is unreachable (offline?)." >&2
    echo "  Run 'piw update' with network access to install pi." >&2
    exit 1
  fi

  if [[ "$dry_run" == "true" ]]; then
    echo "(dry-run) Would install pi ${latest:-latest} (was: ${installed:-none})."
    return 0
  fi

  echo "INFO: Installing pi ${latest:-latest} (was: ${installed:-none}) into app mount…"
  if ! container_run -- sh -c "rm -rf '$PI_MOUNT_PREFIX'/node_modules && npm install --prefix '$PI_MOUNT_PREFIX' '$PI_NPM_PKG@${latest:-latest}'"; then
    echo "ERROR: npm install of pi failed (see output above)." >&2
    exit 1
  fi

  # Verify the installed CLI actually runs from the mount
  if ! container_run -- /opt/pi/node_modules/.bin/pi --version; then
    echo "ERROR: installed pi does not run from /opt/pi (broken mount or install)." >&2
    exit 1
  fi
}

# ── Command: shared tool store ────────────────────────────────────────────────
# mise carries every store tool, so every spec goes to mise. Each command runs
# inside the container and lands in the mounted store.
_tool_install() {
  if [[ $# -eq 0 ]]; then
    echo "ERROR: piw tool install needs at least one spec." >&2
    echo "  Example: piw tool install npm:typescript pypi:ruff" >&2
    exit 1
  fi
  local spec
  for spec in "$@"; do
    echo "INFO: Installing $spec into the tool store…"
    _in_container mise use -g "$spec"
  done
}

_tool_remove() {
  if [[ $# -eq 0 ]]; then
    echo "ERROR: piw tool remove needs at least one spec." >&2
    exit 1
  fi
  local spec
  for spec in "$@"; do
    _in_container mise unuse -g "$spec"
  done
}

_tool_list() {
  _in_container mise ls
}

# ── Command: manage the shared tool store ────────────────────────────────────
cmd_tool() {
  local sub="${1:-list}"
  [[ $# -gt 0 ]] && shift
  case "$sub" in
  install)
    ensure_image
    _tool_install "$@"
    ;;
  remove)
    ensure_image
    _tool_remove "$@"
    ;;
  list)
    ensure_image
    _tool_list
    ;;
  *)
    echo "ERROR: Unknown 'piw tool' subcommand: $sub" >&2
    echo "Usage: piw tool install <spec>... | list | remove <spec>..." >&2
    exit 1
    ;;
  esac
}

# ── Utility: hash a layer directory, ignoring the origin stamp ───────────────
layer_hash() {
  local dir="$1"
  [[ -d "$dir" ]] || return 0
  {
    while IFS= read -r -d '' f; do
      rel="${f#"$dir"/}"
      [[ "$rel" == ".piw-origin" ]] && continue
      printf -- '-- %s --\n' "$rel"
      cat "$f"
    done < <(find "$dir" \( -type f -o -type l \) -print0 2>/dev/null | LC_ALL=C sort -z)
  } | sha256sum | awk '{print $1}'
}

# ── Utility: first non-empty line of a layer's README.md ────────────────────
layer_description() {
  local dir="$1"
  [[ -f "$dir/README.md" ]] || return 0
  awk 'NF { sub(/^[[:space:]]+/, ""); print; exit }' "$dir/README.md"
}

# ── Utility: active layer names from the [layers] section ───────────────────
active_layer_names() {
  local parsed
  parsed="$(parse_piw_conf)" || return 1
  local section entry
  while IFS=$'\t' read -r section entry; do
    [[ "$section" == "layers" ]] || continue
    case "$entry" in
    run:*) printf '%s\n' "${entry#run:}" ;;
    esac
  done <<<"$parsed"
}

# ── Utility: append one entry to the [layers] section ───────────────────────
# The writer adds a section when it is absent. It inserts at the end of the
# last [layers] section, so unrelated lines stay byte-for-byte unchanged.
_append_layer_entry() {
  local entry="$1"
  local conf
  conf="$(resolve_piw_conf)"
  mkdir -p "$(dirname "$conf")"

  if [[ ! -f "$conf" ]]; then
    printf '[layers]\n%s\n' "$entry" > "$conf"
    return 0
  fi

  local last
  last="$(awk '
    function trim(s) { sub(/^[[:space:]]+/, "", s); sub(/[[:space:]]+$/, "", s); return s }
    /^[[:space:]]*\[/ {
      body = $0
      sub(/[[:space:]]+#.*$/, "", body)
      body = trim(body)
      if (body == "[layers]") last = NR
    }
    END { if (last) print last }
  ' "$conf")"

  if [[ -z "$last" ]]; then
    printf '\n[layers]\n%s\n' "$entry" >> "$conf"
    return 0
  fi

  local end
  end="$(awk -v start="$last" 'NR > start && /^[[:space:]]*\[/ { print NR; exit }' "$conf")"
  if [[ -z "$end" ]]; then
    # A file without a trailing newline would glue the entry onto the last line.
    if [[ -n "$(tail -c 1 "$conf")" ]]; then
      printf '\n' >> "$conf"
    fi
    printf '%s\n' "$entry" >> "$conf"
  else
    local tmp
    tmp="$(mktemp)"
    head -n "$((end - 1))" "$conf" > "$tmp"
    printf '%s\n' "$entry" >> "$tmp"
    tail -n "+$end" "$conf" >> "$tmp"
    mv "$tmp" "$conf"
  fi
}

# ── Utility: write a commented starter install.sh ────────────────────────────
_scaffold_install() {
  local file="$1"
  [[ -f "$file" ]] && return 0
  cat > "$file" <<'STARTER'
#!/usr/bin/env bash
# Layer install script. It runs as root inside the image, at build time.
#
# apt packages and archives belong in the `apt` and `archives` files beside
# this script. Use this script for anything they cannot express.
#
# Every command must be non-interactive and safe to rerun.
set -euo pipefail

# Example:
#   install -m 0755 ./tool /usr/local/bin/tool
STARTER
  chmod +x "$file"
}

# ── Utility: the two ways forward after a layer is added ─────────────────────
_layer_add_hint() {
  echo ""
  echo "Two ways forward:"
  echo "  1. Edit the layer files by hand under .local/layers/."
  echo "  2. Launch piw with the harness directory as the workspace, then edit"
  echo "     the same files from inside the container."
}

# ── Command: list shipped and active layers ──────────────────────────────────
cmd_layer_list() {
  local shipped_dir="$SCRIPT_DIR/layers"
  local active_dir="$SCRIPT_DIR/.local/layers"
  local conf
  conf="$(resolve_piw_conf)"

  declare -A layer_status=()
  declare -A layer_desc=()

  local d name
  if [[ -d "$shipped_dir" ]]; then
    while IFS= read -r -d '' d; do
      name="$(basename "$d")"
      layer_status["$name"]="available"
      layer_desc["$name"]="$(layer_description "$d")"
    done < <(find "$shipped_dir" -mindepth 1 -maxdepth 1 -type d -print0 2>/dev/null | LC_ALL=C sort -z)
  fi

  local active_names=""
  if [[ -f "$conf" ]]; then
    active_names="$(active_layer_names)" || return 1
  fi

  local n
  while IFS= read -r n; do
    [[ -n "$n" ]] || continue
    [[ -d "$active_dir/$n" ]] || continue
    layer_status["$n"]="active"
    if [[ -z "${layer_desc[$n]:-}" ]]; then
      layer_desc["$n"]="$(layer_description "$active_dir/$n")"
    fi
  done <<<"$active_names"

  if [[ ${#layer_status[@]} -eq 0 ]]; then
    echo "No layers found."
    return 0
  fi

  printf '%-14s %-10s %s\n' "NAME" "STATUS" "DESCRIPTION"
  for name in $(printf '%s\n' "${!layer_status[@]}" | LC_ALL=C sort); do
    printf '%-14s %-10s %s\n' "$name" "${layer_status[$name]}" "${layer_desc[$name]:-}"
  done
}

# ── Command: show one layer's contents ───────────────────────────────────────
cmd_layer_show() {
  local name="$1"
  local shipped_dir="$SCRIPT_DIR/layers/$name"
  local active_dir="$SCRIPT_DIR/.local/layers/$name"
  local dir source
  if [[ -d "$active_dir" ]]; then
    dir="$active_dir"
    source="adopted"
  elif [[ -d "$shipped_dir" ]]; then
    dir="$shipped_dir"
    source="shipped"
  else
    echo "ERROR: Layer not found: $name" >&2
    echo "  Looked for $active_dir and $shipped_dir." >&2
    exit 1
  fi

  echo "Layer: $name"
  echo "Source: $source"
  echo "Directory: $dir"
  echo ""

  local item found
  echo "apt packages:"
  found="false"
  while IFS= read -r item; do
    [[ -n "$item" ]] || continue
    printf '  %s\n' "$item"
    found="true"
  done < <(_layer_apt_packages "$dir/apt")
  [[ "$found" == "true" ]] || echo "  (none)"

  echo ""
  echo "archives:"
  found="false"
  while IFS= read -r item; do
    [[ -n "$item" ]] || continue
    printf '  %s\n' "$item"
    found="true"
  done < <(_layer_archives "$dir/archives")
  [[ "$found" == "true" ]] || echo "  (none)"

  echo ""
  [[ -f "$dir/mise.toml" ]] && echo "mise.toml: yes" || echo "mise.toml: no"
  [[ -f "$dir/install.sh" ]] && echo "install.sh: yes" || echo "install.sh: no"
}

# ── Command: add a layer (adopt, scaffold, or append apt:) ───────────────────
cmd_layer_add() {
  local arg="${1:-}"
  if [[ -z "$arg" ]]; then
    echo "ERROR: 'piw layer add' needs a name or an apt: entry." >&2
    exit 1
  fi

  # apt:<pkg> [<pkg>...] is one manifest line, appended as-is.
  if [[ "$arg" == apt:* ]]; then
    local entry="$*"
    _append_layer_entry "$entry"
    echo "Added '$entry' to $(resolve_piw_conf)."
    _layer_add_hint
    return 0
  fi

  local name="$arg"
  if [[ ! "$name" =~ ^[A-Za-z0-9_.-]+$ ]]; then
    echo "ERROR: Invalid layer name '$name'." >&2
    echo "  A layer name uses letters, digits, dot, dash, and underscore." >&2
    exit 1
  fi

  local shipped_dir="$SCRIPT_DIR/layers/$name"
  local active_dir="$SCRIPT_DIR/.local/layers/$name"

  if [[ -d "$active_dir" ]]; then
    echo "ERROR: Layer '$name' is already present at $active_dir." >&2
    echo "  Use 'piw layer update $name' to update it." >&2
    exit 1
  fi

  mkdir -p "$(dirname "$active_dir")"
  if [[ -d "$shipped_dir" ]]; then
    cp -R "$shipped_dir" "$active_dir"
    layer_hash "$shipped_dir" > "$active_dir/.piw-origin"
    _append_layer_entry "run:$name"
    echo "Adopted shipped layer '$name' into $active_dir."
    echo "  Wrote the .piw-origin stamp and added 'run:$name' to $(resolve_piw_conf)."
  else
    mkdir -p "$active_dir"
    _scaffold_install "$active_dir/install.sh"
    _append_layer_entry "run:$name"
    echo "Scaffolded layer '$name' at $active_dir."
    echo "  Added 'run:$name' to $(resolve_piw_conf)."
  fi

  _layer_add_hint
}

# ── Command: remove a layer entry from the manifest ──────────────────────────
cmd_layer_remove() {
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    echo "ERROR: 'piw layer remove' needs a name." >&2
    exit 1
  fi
  local conf
  conf="$(resolve_piw_conf)"
  if [[ ! -f "$conf" ]]; then
    echo "ERROR: Layer manifest not found: $conf" >&2
    exit 1
  fi

  local tmp rc=0
  tmp="$(mktemp)"
  awk -v target="run:$name" -v target2="apt:$name" '
    function trim(s) { sub(/^[[:space:]]+/, "", s); sub(/[[:space:]]+$/, "", s); return s }
    BEGIN { section = ""; removed = 0 }
    /^[[:space:]]*\[/ {
      body = $0
      sub(/[[:space:]]+#.*$/, "", body)
      body = trim(body)
      section = substr(body, 2, length(body) - 2)
      print
      next
    }
    {
      line = $0
      if (line ~ /^[[:space:]]*#/ || line ~ /^[[:space:]]*$/) { print; next }
      body = line
      sub(/[[:space:]]+#.*$/, "", body)
      body = trim(body)
      if (section == "layers" && (body == target || body == target2)) { removed = 1; next }
      print
    }
    END { if (!removed) exit 3 }
  ' "$conf" > "$tmp" || rc=$?

  if [[ "$rc" -eq 3 ]]; then
    rm -f "$tmp"
    echo "ERROR: No 'run:$name' or 'apt:$name' entry in $conf." >&2
    exit 1
  elif [[ "$rc" -ne 0 ]]; then
    rm -f "$tmp"
    echo "ERROR: Could not parse $conf." >&2
    exit 1
  fi

  mv "$tmp" "$conf"
  echo "Removed '$name' from $(resolve_piw_conf)."
  local dir="$SCRIPT_DIR/.local/layers/$name"
  if [[ -d "$dir" ]]; then
    echo "Kept the layer directory: $dir"
    echo "  Remove it by hand if you no longer need it."
  fi
}

# ── Command: update an adopted layer from its shipped copy ───────────────────
cmd_layer_update() {
  local name="${1:-}"
  local replace="${2:-false}"
  if [[ -z "$name" ]]; then
    echo "ERROR: 'piw layer update' needs a name." >&2
    exit 1
  fi

  local active_dir="$SCRIPT_DIR/.local/layers/$name"
  local shipped_dir="$SCRIPT_DIR/layers/$name"
  local stamp="$active_dir/.piw-origin"

  if [[ ! -d "$active_dir" ]]; then
    echo "ERROR: Layer '$name' is not active: $active_dir" >&2
    exit 1
  fi
  if [[ ! -d "$shipped_dir" ]]; then
    echo "ERROR: No shipped layer '$name' at $shipped_dir to update from." >&2
    exit 1
  fi
  if [[ ! -f "$stamp" ]]; then
    echo "Layer '$name' was not adopted by piw (no .piw-origin stamp)."
    echo "  Nothing to do. A hand-copied layer is left alone."
    return 0
  fi

  local active_hash shipped_hash
  active_hash="$(layer_hash "$active_dir")"
  shipped_hash="$(layer_hash "$shipped_dir")"

  if [[ "$active_hash" == "$shipped_hash" ]]; then
    echo "Layer '$name' is already up to date."
    return 0
  fi

  local origin
  origin="$(head -1 "$stamp")"
  if [[ "$active_hash" != "$origin" && "$replace" != "true" ]]; then
    echo "Layer '$name' has local changes since adoption."
    echo "  The update would overwrite them. Diff below (local -> shipped):"
    echo ""
    diff -ru --exclude='.piw-origin' "$active_dir" "$shipped_dir" || true
    echo ""
    echo "  To overwrite the local changes, run:"
    echo "    piw layer update $name --replace"
    return 0
  fi

  rm -rf "$active_dir"
  cp -R "$shipped_dir" "$active_dir"
  layer_hash "$shipped_dir" > "$active_dir/.piw-origin"
  echo "Updated layer '$name' from the shipped copy."
  echo "  Rewrote the .piw-origin stamp."
}

# ── Command: launch pi in Docker ──────────────────────────────────────────────
cmd_launch() {
  local workspace="$1"
  local resume="${2:-false}"
  local mode="${3:-permissive}"

  # Workspace must exist
  if [[ ! -d "$workspace" ]]; then
    echo "ERROR: Workspace not found: $workspace" >&2
    exit 1
  fi

  # Resolve config dir (default: .local/agent inside harness)
  local config_dir
  config_dir="$(resolve_config_dir)"

  # Validate the mode before any expensive work.
  validate_mode "$mode"

  bootstrap_config "$config_dir"
  bootstrap_permissions
  bootstrap_starters
  ensure_local_namespace

  # ensure_pi builds the image when missing (ensure_image) and checks the
  # pi install in the config mount.
  ensure_pi require

  # Cheap pre-exec guard: a corrupted/empty app mount that still passes the
  # version read would otherwise die inside the container with an opaque
  # exec error. Fail here with an actionable message instead.
  local pi_host
  pi_host="$(resolve_pi_host_dir)"
  if [[ ! -x "$pi_host/node_modules/.bin/pi" ]]; then
    echo "ERROR: pi CLI missing in app mount ($pi_host)." >&2
    echo "  Run 'piw update' (or delete .local/app and retry) to repair." >&2
    exit 1
  fi

  # The mode is validated above. The container seam resolves the mode config
  # and the read-only restrictions from it.
  local pi_args=()
  [[ "$resume" == "true" ]] && pi_args+=(-r)
  local session_flag=""
  [[ "$resume" == "true" ]] && session_flag=" (resume mode)"

  # The manifest decides the image and the expected plan hash. A manifest with
  # any layer entry needs the composed image; otherwise the default image.
  local steps image expected_hash
  if ! steps="$(resolve_layers)"; then
    exit 1
  fi
  if [[ -n "$steps" ]]; then
    image="${IMAGE_PREFIX}:local"
    if ! expected_hash="$(plan_hash)"; then
      exit 1
    fi
  else
    image="${IMAGE_PREFIX}:default"
    if ! expected_hash="$(default_plan_hash)"; then
      exit 1
    fi
  fi

  # Staleness check. One inspect reads the label written at build time. The
  # image label is the single source of image state; no stamp file exists. A
  # missing piw:default on a first run is not stale: ensure_image built it.
  local label
  if ! label="$(docker image inspect \
    --format '{{index .Config.Labels "piw.plan"}}' "$image" 2>/dev/null)"; then
    echo "ERROR: Required image '$image' is missing." >&2
    echo "  Run 'piw build' to build it." >&2
    exit 1
  fi
  if [[ -z "$label" || "$label" != "$expected_hash" ]]; then
    echo "ERROR: Image '$image' is stale." >&2
    echo "  The image was not built from the current plan." >&2
    echo "  Expected plan hash: $expected_hash" >&2
    echo "  Image plan hash:    ${label:-<none>}" >&2
    echo "  Run 'piw build' to rebuild the image." >&2
    exit 1
  fi

  echo "INFO: Launching piw in $workspace (mode: $mode)$session_flag"
  container_run \
    --workspace "$workspace" \
    --mode "$mode" \
    --image "$image" \
    --secrets \
    --interactive \
    -- pi "${pi_args[@]}"
}

# ── Internal: build the default image (no package install) ──────────────────
_build_single() {
  local no_cache="$1"
  local image_tag="${IMAGE_PREFIX}:default"

  if [[ ! -f "$SCRIPT_DIR/Dockerfile" ]]; then
    echo "ERROR: Dockerfile not found at $SCRIPT_DIR/Dockerfile" >&2
    echo "  The default image builds from the repository root Dockerfile." >&2
    exit 1
  fi

  local hash
  if ! hash="$(default_plan_hash)"; then
    return 1
  fi

  local -a build_args=(-f "$SCRIPT_DIR/Dockerfile" -t "$image_tag" "$SCRIPT_DIR")
  if [[ "$no_cache" == "true" ]]; then
    build_args=("--no-cache" "${build_args[@]}")
  fi
  build_args+=(--label "piw.plan=$hash")

  echo "INFO: Building $image_tag…"
  docker build "${build_args[@]}"
  echo "INFO: Build complete: $image_tag"
}

# ── Internal: build the composed layer image (piw:local) ─────────────────────
_build_local() {
  local no_cache="$1"
  local plan hash
  if ! plan="$(compose_plan)"; then
    return 1
  fi
  if ! hash="$(plan_hash)"; then
    return 1
  fi

  local -a build_args=(build -f - -t "${IMAGE_PREFIX}:local" --label "piw.plan=$hash")
  if [[ "$no_cache" == "true" ]]; then
    build_args+=(--no-cache)
  fi
  build_args+=("$SCRIPT_DIR/.local/layers")

  echo "INFO: Building ${IMAGE_PREFIX}:local…"
  docker "${build_args[@]}" <<<"$plan"
  echo "INFO: Build complete: ${IMAGE_PREFIX}:local"
}

# ── Utility: populate the store with the global and active-layer tools ───────
# mise reads the global config from MISE_GLOBAL_CONFIG_FILE and a layer's
# mise.toml with -C. Both installs run in the image just built and write to the
# mounted store (.local/store at /home/pi/.local), so they survive a rebuild.
# A dry run prints the steps and runs no container.
install_store() {
  local image="$1"
  local dry_run="${2:-false}"
  local steps kind name

  if ! steps="$(resolve_layers)"; then
    return 1
  fi

  if [[ "$dry_run" == "true" ]]; then
    echo "(dry-run) Would install the global store tools: mise install"
    while IFS=$'\t' read -r kind name _; do
      [[ "$kind" == "run" ]] || continue
      echo "(dry-run) Would install layer '$name' store tools: mise -C /opt/piw/layers/$name install"
    done <<<"$steps"
    return 0
  fi

  echo "INFO: Installing the global store tools…"
  container_run --image "$image" -- mise install

  while IFS=$'\t' read -r kind name _; do
    [[ "$kind" == "run" ]] || continue
    echo "INFO: Installing store tools for layer '$name'…"
    container_run --image "$image" -- mise -C "/opt/piw/layers/$name" install
  done <<<"$steps"
}

# ── Command: build the default image and the composed layer image ────────────
cmd_build() {
  local no_cache="${1:-false}"
  local dry_run="${2:-false}"

  # Seeding writes, so a dry run skips it and changes nothing.
  if [[ "$dry_run" != "true" ]]; then
    bootstrap_starters
  fi

  # Resolve before Docker: a missing manifest or layer stops here.
  local steps
  if ! steps="$(resolve_layers)"; then
    exit 1
  fi

  # Render the plan before Docker, so a malformed archive or a bad layer
  # stops here rather than after the default image is built.
  if ! compose_plan >/dev/null; then
    exit 1
  fi

  if [[ "$dry_run" == "true" ]]; then
    echo "INFO: (dry-run) Build plan:"
    if ! compose_plan; then
      exit 1
    fi
    echo ""
    install_store "${IMAGE_PREFIX}:default" "true"
    echo "INFO: (dry-run) Nothing executed."
    return 0
  fi

  _build_single "$no_cache"

  local image="${IMAGE_PREFIX}:default"
  if [[ -n "$steps" ]]; then
    mkdir -p "$SCRIPT_DIR/.local/layers"
    _build_local "$no_cache"
    image="${IMAGE_PREFIX}:local"
  fi

  # Populate the store in the image just built, then provision pi.
  install_store "$image"
  ensure_pi require

  cmd_generate_catalog  # refresh catalog, skills may have changed
}

# ── Command: put piw on PATH (link a symlink into a directory) ────────────────
cmd_link() {
  local target_dir="${1:-$HOME/.local/bin}"
  local link_path="$target_dir/piw"
  local piw_path="$SCRIPT_DIR/piw"

  mkdir -p "$target_dir"

  if [[ -L "$link_path" ]]; then
    local current
    current="$(readlink "$link_path")"
    if [[ "$current" == "$piw_path" ]]; then
      echo "✓ piw already linked at $link_path"
    else
      ln -sf "$piw_path" "$link_path"
      echo "✓ Updated symlink: $link_path → $piw_path (was → $current)"
    fi
  elif [[ -f "$link_path" ]]; then
    echo "ERROR: $link_path exists and is not a symlink. Remove it first." >&2
    exit 1
  else
    ln -s "$piw_path" "$link_path"
    echo "✓ Linked: $link_path → $piw_path"
  fi

  # Seed configs and create the namespace (same as launch does)
  local config_dir
  config_dir="$(resolve_config_dir)"
  ensure_local_namespace
  bootstrap_config "$config_dir"
  bootstrap_permissions
  bootstrap_starters

  if [[ ":$PATH:" != *":$target_dir:"* ]]; then
    echo ""
    echo "NOTE: $target_dir is not on your PATH. Add this to ~/.bashrc / ~/.zshrc:"
    echo "  export PATH=\"\$PATH:$target_dir\""
  fi

  echo ""
  echo "✓ piw linked. Run 'piw' to launch."
}

# ── Command: take piw off PATH (remove the symlink) ───────────────────────────
cmd_unlink() {
  local target_dir="${1:-$HOME/.local/bin}"
  local link_path="$target_dir/piw"
  local piw_path="$SCRIPT_DIR/piw"

  if [[ ! -L "$link_path" ]] && [[ ! -e "$link_path" ]]; then
    echo "✓ piw not found at $link_path (nothing to remove)"
    return
  fi

  if [[ -L "$link_path" ]]; then
    local current
    current="$(readlink "$link_path")"
    if [[ "$current" != "$piw_path" ]]; then
      echo "ERROR: $link_path points to $current, not $piw_path. Not removing." >&2
      exit 1
    fi
    rm "$link_path"
    echo "✓ Removed symlink: $link_path"
  else
    echo "ERROR: $link_path is a regular file. Remove manually." >&2
    exit 1
  fi

  local config_dir
  config_dir="$(resolve_config_dir)"
  if [[ -d "$config_dir" ]]; then
    echo ""
    echo "NOTE: Config directory still exists at $config_dir"
    echo "  Remove with: rm -rf $config_dir"
  fi
}

# ── Utility: declared store tools from a mise config ─────────────────────────
# Reads the [tools] keys. A key may be bare (`jq`) or quoted (`"npm:x"`).
_declared_tools() {
  local file="$1"
  [[ -f "$file" ]] || return 0
  awk '
    function trim(s) { sub(/^[[:space:]]+/, "", s); sub(/[[:space:]]+$/, "", s); return s }
    BEGIN { section = "" }
    /^[[:space:]]*\[/ {
      body = $0
      sub(/[[:space:]]*#.*$/, "", body)
      body = trim(body)
      section = (body == "[tools]") ? "tools" : ""
      next
    }
    {
      line = $0
      if (line ~ /^[[:space:]]*#/ || line ~ /^[[:space:]]*$/) next
      if (section != "tools") next
      eq = index(line, "=")
      if (eq == 0) next
      key = trim(substr(line, 1, eq - 1))
      gsub(/^"|"$/, "", key)
      if (key != "") print key
    }
  ' "$file"
}

# ── Utility: the short tool name that a store install directory uses ─────────
# ── Utility: report one seeded file against its seed (never fails) ───────────
_doctor_seed_diff() {
  local label="$1" live="$2" seed="$3"
  if [[ ! -f "$seed" ]]; then
    echo "   $label: no seed shipped"
    return 0
  fi
  if [[ ! -f "$live" ]]; then
    echo "   $label: not seeded yet"
    return 0
  fi
  if diff -q "$seed" "$live" &>/dev/null; then
    echo "   $label: matches the seed"
    return 0
  fi
  echo "   $label: DIFFERS from the seed"
  diff -u "$seed" "$live" | sed 's/^/     /' || true
}

# ── Utility: report every seeded file against its seed (never fails) ─────────
# The same list feeds `doctor` check 4 and `update` step 2, so the two stay in
# step. The files belong to the user; a diff is a report, not a failure.
report_seed_drift() {
  local config_dir
  config_dir="$(resolve_config_dir)"
  _doctor_seed_diff "settings.json" "$config_dir/settings.json" "$SCRIPT_DIR/seed/settings.json"
  _doctor_seed_diff "models.json" "$config_dir/models.json" "$SCRIPT_DIR/seed/models.json"
  local s
  for s in "$SCRIPT_DIR"/seed/permissions/config*.json; do
    [[ -f "$s" ]] || continue
    _doctor_seed_diff "permissions/$(basename "$s")" \
      "$config_dir/extensions/pi-permission-system/$(basename "$s")" "$s"
  done
  _doctor_seed_diff "piw.conf" "$(resolve_piw_conf)" "$SCRIPT_DIR/seed/piw.conf"
  _doctor_seed_diff "mise/config.toml" "$(resolve_mise_config)" "$SCRIPT_DIR/seed/mise/config.toml"
}

# ── Command: diagnose the harness ────────────────────────────────────────────
# Four checks. Checks 1 to 3 decide the exit code. Check 4 reports drift as a
# diff and never fails: the seeded files belong to the user.
#
# Exit code: 0 when checks 1 to 3 pass, 1 when any of them fails.
cmd_doctor() {
  local failures=0
  echo "piw doctor"
  echo ""

  # 1. Docker and the daemon.
  echo "1. Docker"
  if command -v docker &>/dev/null; then
    echo "   docker: $(command -v docker)"
    if docker info &>/dev/null 2>&1; then
      echo "   daemon: reachable"
    else
      echo "   daemon: NOT reachable"
      ((failures += 1))
    fi
  else
    echo "   docker: NOT on PATH"
    ((failures += 1))
  fi
  echo ""

  # 2. Image. piw:local wins when it exists, else piw:default.
  echo "2. Image"
  local image="${IMAGE_PREFIX}:default"
  if docker image inspect "${IMAGE_PREFIX}:local" &>/dev/null 2>&1; then
    image="${IMAGE_PREFIX}:local"
  fi
  if docker image inspect "$image" &>/dev/null 2>&1; then
    echo "   $image: present"
  else
    echo "   $image: MISSING"
    ((failures += 1))
  fi
  echo ""

  # 3. Store agrees with the manifest.
  echo "3. Store"
  local store_failures=0
  local -a declared=()
  local spec
  while IFS= read -r spec; do
    [[ -n "$spec" ]] && declared+=("global:$spec")
  done < <(_declared_tools "$(resolve_mise_config)")

  local steps="" kind name dir
  if [[ -f "$(resolve_piw_conf)" ]]; then
    if steps="$(resolve_layers 2>/dev/null)"; then
      while IFS=$'\t' read -r kind name dir; do
        [[ "$kind" == "run" ]] || continue
        while IFS= read -r spec; do
          [[ -n "$spec" ]] && declared+=("$name:$spec")
        done < <(_declared_tools "$dir/mise.toml")
      done <<<"$steps"
    else
      echo "   manifest could not be resolved: $(resolve_piw_conf)"
      ((store_failures += 1))
    fi
  fi

  if [[ ${#declared[@]} -eq 0 ]]; then
    echo "   no tools declared"
  elif ! docker image inspect "$image" &>/dev/null 2>&1; then
    echo "   cannot check: image $image is missing"
    ((store_failures += 1))
  else
    # Ask mise, do not guess its install layout.
    local installed_list
    installed_list="$(container_run --image "$image" -- mise ls 2>/dev/null || true)"
    local item scope tool
    for item in "${declared[@]}"; do
      scope="${item%%:*}"
      tool="${item#*:}"
      if grep -Fq -- "$tool" <<<"$installed_list"; then
        echo "   installed: $tool ($scope)"
      else
        echo "   MISSING: $tool ($scope)"
        ((store_failures += 1))
      fi
    done
  fi
  [[ "$store_failures" -gt 0 ]] && ((failures += 1))
  echo ""

  # 4. Seeds. A diff is a report, never a failure.
  echo "4. Seeds (a diff is a report, not a failure)"
  report_seed_drift
  echo ""

  echo "Exit code rule: 0 when checks 1-3 pass, 1 when any of them fails."
  echo "                Check 4 never changes the exit code."
  if [[ "$failures" -eq 0 ]]; then
    return 0
  fi
  return 1
}

# ── Command: regenerate skills catalog ────────────────────────────────────────
cmd_generate_catalog() {
  local script="$SCRIPT_DIR/skills/generate-catalog.sh"
  if [[ ! -f "$script" ]]; then
    echo "ERROR: generate-catalog.sh not found at $script" >&2
    exit 1
  fi
  echo "Regenerating skills catalog…"
  bash "$script"
}

# ── Command: update harness, images, and pi ──────────────────────────────────
# Four steps, in order: pull the harness, report seeded drift, rebuild, and
# update pi in the container. A divergent pull stops the update.
cmd_update() {
  local no_cache="${1:-false}"
  local dry_run="${2:-false}"
  local force="${3:-false}"

  echo "piw update"
  echo ""

  # 1) Pull the harness. --ff-only refuses to guess on divergence.
  echo "1. Pull the harness"
  if [[ "$dry_run" == "true" ]]; then
    echo "   (dry-run) Would run: git pull --ff-only"
  elif git -C "$SCRIPT_DIR" remote 2>/dev/null | grep -q .; then
    echo "   git pull --ff-only"
    if ! git -C "$SCRIPT_DIR" pull --ff-only; then
      echo "ERROR: git pull --ff-only failed." >&2
      echo "  The branch diverged from the remote, or local changes overlap." >&2
      echo "  Resolve it by hand, then retry. piw does not merge." >&2
      return 1
    fi
  else
    echo "   No git remote configured. Skipping the pull."
  fi
  echo ""

  # 2) Report seeded-config drift. A diff, never a failure.
  echo "2. Seeded config drift (a diff is a report, not a failure)"
  if [[ "$dry_run" == "true" ]]; then
    echo "   (dry-run) Would report settings.json, models.json, permissions, piw.conf, and mise/config.toml"
  else
    report_seed_drift
  fi
  echo ""

  # 3) Rebuild the default image, the composed image, and the store.
  echo "3. Rebuild"
  if [[ "$dry_run" == "true" ]]; then
    echo "   (dry-run) Would run: piw build"
  else
    cmd_build "$no_cache" "false"
  fi
  echo ""

  # 4) Update pi, the extensions, and the model catalogs in one command.
  echo "4. Update pi"
  local image
  image="$(launch_image)"
  local -a pi_args=(update --all)
  [[ "$force" == "true" ]] && pi_args+=(--force)
  if [[ "$dry_run" == "true" ]]; then
    echo "   (dry-run) Would run in $image: pi ${pi_args[*]}"
  else
    echo "   $image: pi ${pi_args[*]}"
    container_run --image "$image" -- pi "${pi_args[@]}"
  fi

  echo ""
  if [[ "$dry_run" == "true" ]]; then
    echo "✓ (dry-run) Nothing executed. Run without --dry-run to apply."
  else
    echo "✓ Update complete. Run 'piw' to launch."
  fi
}

# ── Source guard ─────────────────────────────────────────────────────────────
# Sourcing defines the functions without running a command. The test suite uses
# this to call the parser and the resolvers directly.
if [[ "${BASH_SOURCE[0]}" != "${0}" ]]; then
  return 0
fi

# ── Parser: reject a flag the command does not accept ────────────────────────
reject_flag() {
  local cmd="$1" flag="$2"
  echo "ERROR: '$flag' is not a flag of the '$cmd' command." >&2
  echo "  Run 'piw --help' for the command set and each command's flags." >&2
  exit 1
}

# ── Parser: the launch command (the default case) ────────────────────────────
parse_launch() {
  local mode="${PIW_MODE:-permissive}"
  local resume="false"
  local -a positional=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --mode)
      if [[ -z "${2:-}" ]]; then
        echo "ERROR: --mode requires an argument." >&2
        exit 1
      fi
      mode="$2"
      shift 2
      ;;
    -r | --resume)
      resume="true"
      shift
      ;;
    --)
      shift
      positional+=("$@")
      break
      ;;
    -*)
      reject_flag launch "$1"
      ;;
    *)
      positional+=("$1")
      shift
      ;;
    esac
  done
  if [[ ${#positional[@]} -gt 1 ]]; then
    echo "ERROR: Launch accepts at most one workspace path." >&2
    exit 1
  fi
  cmd_launch "${positional[0]:-$(pwd)}" "$resume" "$mode"
}

# ── Parser: piw build ────────────────────────────────────────────────────────
parse_build() {
  local no_cache="false"
  local dry_run="false"
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --no-cache) no_cache="true"; shift ;;
    --dry-run) dry_run="true"; shift ;;
    -*) reject_flag build "$1" ;;
    *)
      echo "ERROR: 'piw build' takes no arguments: $1" >&2
      exit 1
      ;;
    esac
  done
  cmd_build "$no_cache" "$dry_run"
}

# ── Parser: piw tool ─────────────────────────────────────────────────────────
parse_tool() {
  local sub="${1:-list}"
  [[ $# -gt 0 ]] && shift
  case "$sub" in
  install | remove | list) ;;
  -*) reject_flag tool "$sub" ;;
  *)
    echo "ERROR: Unknown 'piw tool' subcommand: $sub" >&2
    echo "Usage: piw tool install <spec>... | list | remove <spec>..." >&2
    exit 1
    ;;
  esac
  local arg
  for arg in "$@"; do
    case "$arg" in
    -*) reject_flag tool "$arg" ;;
    esac
  done
  cmd_tool "$sub" "$@"
}

# ── Parser: piw layer ────────────────────────────────────────────────────────
parse_layer() {
  local sub="${1:-list}"
  [[ $# -gt 0 ]] && shift
  case "$sub" in
  list)
    [[ $# -eq 0 ]] || { echo "ERROR: 'piw layer list' takes no arguments." >&2; exit 1; }
    cmd_layer_list
    ;;
  show)
    [[ $# -eq 1 && "$1" != -* ]] || { echo "ERROR: 'piw layer show' needs one layer name." >&2; exit 1; }
    cmd_layer_show "$1"
    ;;
  add)
    [[ $# -ge 1 && "$1" != -* ]] || { echo "ERROR: 'piw layer add' needs a name or an apt: entry." >&2; exit 1; }
    local arg
    for arg in "$@"; do
      case "$arg" in
      -*) reject_flag layer "$arg" ;;
      esac
    done
    cmd_layer_add "$@"
    ;;
  remove)
    [[ $# -eq 1 && "$1" != -* ]] || { echo "ERROR: 'piw layer remove' needs one layer name." >&2; exit 1; }
    cmd_layer_remove "$1"
    ;;
  update)
    local name=""
    local replace="false"
    local arg
    for arg in "$@"; do
      case "$arg" in
      --replace) replace="true" ;;
      -*) reject_flag layer "$arg" ;;
      *)
        if [[ -n "$name" ]]; then
          echo "ERROR: 'piw layer update' takes one layer name." >&2
          exit 1
        fi
        name="$arg"
        ;;
      esac
    done
    [[ -n "$name" ]] || { echo "ERROR: 'piw layer update' needs one layer name." >&2; exit 1; }
    cmd_layer_update "$name" "$replace"
    ;;
  -*) reject_flag layer "$sub" ;;
  *)
    echo "ERROR: Unknown 'piw layer' subcommand: $sub" >&2
    echo "Usage: piw layer add <name|apt:...> | remove <name> | list | show <name> | update <name> [--replace]" >&2
    exit 1
    ;;
  esac
}

# ── Parser: piw doctor ───────────────────────────────────────────────────────
parse_doctor() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
    -*) reject_flag doctor "$1" ;;
    *)
      echo "ERROR: 'piw doctor' takes no arguments: $1" >&2
      exit 1
      ;;
    esac
  done
  cmd_doctor
}

# ── Parser: piw link and piw unlink ──────────────────────────────────────────
parse_link() {
  local -a positional=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
    -*) reject_flag link "$1" ;;
    *)
      positional+=("$1")
      shift
      ;;
    esac
  done
  [[ ${#positional[@]} -le 1 ]] || { echo "ERROR: 'piw link' takes at most one directory." >&2; exit 1; }
  cmd_link "${positional[0]:-}"
}

parse_unlink() {
  local -a positional=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
    -*) reject_flag unlink "$1" ;;
    *)
      positional+=("$1")
      shift
      ;;
    esac
  done
  [[ ${#positional[@]} -le 1 ]] || { echo "ERROR: 'piw unlink' takes at most one directory." >&2; exit 1; }
  cmd_unlink "${positional[0]:-}"
}

# ── Parser: piw generate-catalog ─────────────────────────────────────────────
parse_generate_catalog() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
    -*) reject_flag generate-catalog "$1" ;;
    *)
      echo "ERROR: 'piw generate-catalog' takes no arguments: $1" >&2
      exit 1
      ;;
    esac
  done
  cmd_generate_catalog
}

# ── Parser: piw update ───────────────────────────────────────────────────────
parse_update() {
  local no_cache="false"
  local force="false"
  local dry_run="false"
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --no-cache) no_cache="true"; shift ;;
    --force) force="true"; shift ;;
    --dry-run) dry_run="true"; shift ;;
    -*) reject_flag update "$1" ;;
    *)
      echo "ERROR: 'piw update' takes no arguments: $1" >&2
      exit 1
      ;;
    esac
  done
  cmd_update "$no_cache" "$dry_run" "$force"
}

# ── Main: pick the command, then parse its flags ─────────────────────────────
main() {
  # Two options stand alone, before any command.
  case "${1:-}" in
  -h | --help) show_help ;;
  --version)
    printf 'piw %s\n' "$PIW_VERSION"
    exit 0
    ;;
  esac

  # A known command word selects the command. Anything else is a launch.
  local command="launch"
  if [[ $# -gt 0 ]]; then
    case "$1" in
    build | tool | layer | doctor | link | unlink | generate-catalog | update)
      command="$1"
      shift
      ;;
    esac
  fi

  case "$command" in
  launch) parse_launch "$@" ;;
  build) parse_build "$@" ;;
  tool) parse_tool "$@" ;;
  layer) parse_layer "$@" ;;
  doctor) parse_doctor "$@" ;;
  link) parse_link "$@" ;;
  unlink) parse_unlink "$@" ;;
  generate-catalog) parse_generate_catalog "$@" ;;
  update) parse_update "$@" ;;
  esac
}

main "$@"
